{
  "name": "seasonal-themes",
  "displayName": "Seasonal Themes",
  "description": "A colour theme for every month of the year, generated from the same season documents as the matching Oh My Posh prompts.",
  "version": "0.2.0",
  "publisher": "topicomha",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/topicomha/SeasonalThemes"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "seasonal",
    "holiday",
    "monthly",
    "color theme"
  ],
  "galleryBanner": {
    "color": "#2D3436",
    "theme": "dark"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Seasonal 01 · January — Winter Wonderland · Dark ❄️",
        "uiTheme": "vs-dark",
        "path": "./themes/january-dark.json"
      },
      {
        "label": "Seasonal 01 · January — Winter Wonderland · Light ❄️",
        "uiTheme": "vs",
        "path": "./themes/january-light.json"
      },
      {
        "label": "Seasonal 02 · February — Valentine's Day · Dark 🌹",
        "uiTheme": "vs-dark",
        "path": "./themes/february-dark.json"
      },
      {
        "label": "Seasonal 02 · February — Valentine's Day · Light 🌹",
        "uiTheme": "vs",
        "path": "./themes/february-light.json"
      },
      {
        "label": "Seasonal 03 · March — St. Patrick's Day ☘️",
        "uiTheme": "vs-dark",
        "path": "./themes/march-dark.json"
      },
      {
        "label": "Seasonal 04 · April — Spring Showers 🐰",
        "uiTheme": "vs-dark",
        "path": "./themes/april-dark.json"
      },
      {
        "label": "Seasonal 05 · May — May Flowers 🕊️",
        "uiTheme": "vs-dark",
        "path": "./themes/may-dark.json"
      },
      {
        "label": "Seasonal 06 · June — Summer Vacation 😎",
        "uiTheme": "vs-dark",
        "path": "./themes/june-dark.json"
      },
      {
        "label": "Seasonal 07 · July — Independence Day 🎆",
        "uiTheme": "vs-dark",
        "path": "./themes/july-dark.json"
      },
      {
        "label": "Seasonal 08 · August — Late Summer ☀️",
        "uiTheme": "vs-dark",
        "path": "./themes/august-dark.json"
      },
      {
        "label": "Seasonal 09 · September — Back to School 🍎",
        "uiTheme": "vs-dark",
        "path": "./themes/september-dark.json"
      },
      {
        "label": "Seasonal 10 · October — Halloween 🍂",
        "uiTheme": "vs-dark",
        "path": "./themes/october-dark.json"
      },
      {
        "label": "Seasonal 11 · November — Thanksgiving 🍂",
        "uiTheme": "vs-dark",
        "path": "./themes/november-dark.json"
      },
      {
        "label": "Seasonal 12 · December — Holiday Season 🎄",
        "uiTheme": "vs-dark",
        "path": "./themes/december-dark.json"
      },
      {
        "label": "Seasonal 12 · December — New Year's Eve 🥳",
        "uiTheme": "vs-dark",
        "path": "./themes/december-new-years-eve-dark.json"
      }
    ],
    "commands": [
      {
        "command": "seasonalThemes.useCurrentMonth",
        "title": "Seasonal Themes: Use This Month's Theme"
      }
    ],
    "configuration": {
      "title": "Seasonal Themes",
      "properties": {
        "seasonalThemes.autoSwitch": {
          "type": "boolean",
          "default": true,
          "description": "When a Seasonal theme is active, switch to the current month's theme (and date variants like New Year's Eve) automatically."
        },
        "seasonalThemes.mode": {
          "type": "string",
          "enum": [
            "system",
            "time",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow the operating system's light/dark setting (turns on window.autoDetectColorScheme and sets the preferred light and dark themes to this month's).",
            "Light between seasonalThemes.lightFrom and seasonalThemes.darkFrom, dark the rest of the day.",
            "Always this month's light theme.",
            "Always this month's dark theme."
          ],
          "default": "system",
          "description": "How to choose between the month's light and dark themes."
        },
        "seasonalThemes.lightFrom": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "default": "07:00",
          "description": "With mode 'time': when the light theme starts (24-hour HH:MM, local time)."
        },
        "seasonalThemes.darkFrom": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "default": "19:00",
          "description": "With mode 'time': when the dark theme starts (24-hour HH:MM, local time)."
        }
      }
    }
  },
  "seasonalSchedule": [
    {
      "month": 1,
      "mode": "dark",
      "label": "Seasonal 01 · January — Winter Wonderland · Dark ❄️"
    },
    {
      "month": 1,
      "mode": "light",
      "label": "Seasonal 01 · January — Winter Wonderland · Light ❄️"
    },
    {
      "month": 2,
      "mode": "dark",
      "label": "Seasonal 02 · February — Valentine's Day · Dark 🌹"
    },
    {
      "month": 2,
      "mode": "light",
      "label": "Seasonal 02 · February — Valentine's Day · Light 🌹"
    },
    {
      "month": 3,
      "mode": "dark",
      "label": "Seasonal 03 · March — St. Patrick's Day ☘️"
    },
    {
      "month": 4,
      "mode": "dark",
      "label": "Seasonal 04 · April — Spring Showers 🐰"
    },
    {
      "month": 5,
      "mode": "dark",
      "label": "Seasonal 05 · May — May Flowers 🕊️"
    },
    {
      "month": 6,
      "mode": "dark",
      "label": "Seasonal 06 · June — Summer Vacation 😎"
    },
    {
      "month": 7,
      "mode": "dark",
      "label": "Seasonal 07 · July — Independence Day 🎆"
    },
    {
      "month": 8,
      "mode": "dark",
      "label": "Seasonal 08 · August — Late Summer ☀️"
    },
    {
      "month": 9,
      "mode": "dark",
      "label": "Seasonal 09 · September — Back to School 🍎"
    },
    {
      "month": 10,
      "mode": "dark",
      "label": "Seasonal 10 · October — Halloween 🍂"
    },
    {
      "month": 11,
      "mode": "dark",
      "label": "Seasonal 11 · November — Thanksgiving 🍂"
    },
    {
      "month": 12,
      "mode": "dark",
      "label": "Seasonal 12 · December — Holiday Season 🎄"
    },
    {
      "month": 12,
      "mode": "dark",
      "label": "Seasonal 12 · December — New Year's Eve 🥳",
      "from": "12-26",
      "to": "12-31"
    }
  ]
}
