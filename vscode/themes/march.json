  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8FAF98", "fontStyle": "italic" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#C08A3E", "fontStyle": "" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#E8F3EA", "fontStyle": "" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#32CD32", "fontStyle": "" } },
    { "name": "Regular expressions", "scope": ["string.regexp"], "settings": { "foreground": "#32CD32", "fontStyle": "" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#FFD700", "fontStyle": "" } },
    { "name": "Constants", "scope": ["constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant"], "settings": { "foreground": "#FFD700", "fontStyle": "" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#009E60", "fontStyle": "" } },
    { "name": "Types", "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive"], "settings": { "foreground": "#C58FD6", "fontStyle": "" } },
    { "name": "Variables", "scope": ["variable", "variable.other", "variable.other.readwrite"], "settings": { "foreground": "#E8F3EA", "fontStyle": "" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#E8F3EA", "fontStyle": "" } },
    { "name": "Properties", "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#E8F3EA", "fontStyle": "" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#E8F3EA", "fontStyle": "" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#C08A3E", "fontStyle": "" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#009E60", "fontStyle": "" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#E86A5C", "fontStyle": "" } },
    { "name": "Markup headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#C08A3E", "fontStyle": "bold" } },
    { "name": "Markup bold", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "Markup italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markup code", "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#32CD32" } },
    { "name": "Markup links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#6FA8DC" } },
    { "name": "Markup quotes", "scope": ["markup.quote"], "settings": { "foreground": "#8FAF98", "fontStyle": "italic" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#32CD32" } },
    { "name": "Diff deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#E86A5C" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#FFD700" } }
  ],
  "semanticTokenColors": {
    "namespace": "#C58FD6",
    "class": "#C58FD6",
    "interface": "#C58FD6",
    "enum": "#C58FD6",
    "struct": "#C58FD6",
    "type": "#C58FD6",
    "typeParameter": "#C58FD6",
    "function": "#009E60",
    "method": "#009E60",
    "macro": "#009E60",
    "parameter": "#E8F3EA",
    "property": "#E8F3EA",
    "enumMember": "#FFD700",
    "variable": "#E8F3EA",
    "variable.readonly": "#FFD700",
    "keyword": "#C08A3E",
    "string": "#32CD32",
    "number": "#FFD700",
    "regexp": "#32CD32",
    "comment": "#8FAF98"
  }
}
