{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "November",
  "name": "Thanksgiving",
  "tagline": "Falling leaves, a full table and a whole lot of gratitude",
  "description": [
    "November is the height of fall: deep oranges, browns and golden tones with fall foliage and Thanksgiving feast imagery.",
    "The colours are currently the same as October's; the turkeys, drumsticks and maple leaves are what set it apart."
  ],
  "mood": ["cozy", "grateful", "warm", "abundant"],
  "keywords": ["Thanksgiving table", "roast turkey", "pumpkin pie", "maple leaves", "corn harvest", "cornucopia", "fireplace"],
  "holidays": [
    { "name": "Thanksgiving (US)", "date": "11-22", "note": "4th Thursday, between the 22nd and 28th" }
  ],
  "links": [
    { "title": "Emojipedia: Thanksgiving", "url": "https://emojipedia.org/thanksgiving" },
    { "title": "Emojipedia: Fall / Autumn", "url": "https://emojipedia.org/fall-autumn" }
  ],
  "ideas": [
    "More Thanksgiving food: 🥧 pie, 🌽 corn, 🍠 sweet potato",
    "Use 🦃 turkey more prominently throughout the theme",
    "🍊 tangerine for autumn fruit",
    "Give November its own harvest palette so it doesn't share October's colours"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "warm_orange": { "hex": "#D35400", "name": "Warm orange" },
    "roast":       { "hex": "#A04000", "name": "Roast brown" },
    "pumpkin":     { "hex": "#E67E22", "name": "Pumpkin orange" },
    "harvest":     { "hex": "#F1C40F", "name": "Harvest gold" },
    "amber":       { "hex": "#F39C12", "name": "Amber" },
    "walnut":      { "hex": "#523422", "name": "Walnut" },
    "plum":        { "hex": "#8E44AD", "name": "Plum" },
    "butter":      { "hex": "#FFFB38", "name": "Butter yellow" },
    "cream":       { "hex": "#E0F8FF", "name": "Cream" },
    "white":       { "hex": "#FFFFFF", "name": "White" },
    "charcoal":    { "hex": "#2D3436", "name": "Charcoal" },
    "hearth":      { "hex": "#2A1F1A", "name": "Hearth", "note": "Proposed: editor and terminal background" },
    "oak":         { "hex": "#3A2C24", "name": "Oak table", "note": "Proposed: panels, borders, current line" },
    "linen":       { "hex": "#F5E6D3", "name": "Linen", "note": "Proposed: editor text" },
    "oatmeal":     { "hex": "#B5A48B", "name": "Oatmeal", "note": "Proposed: comments, muted text" },
    "cranberry":   { "hex": "#D9655F", "name": "Cranberry", "note": "Proposed: terminal red, invalid code" },
    "sage":        { "hex": "#8A9A5B", "name": "Sage", "note": "Proposed: terminal green, strings" },
    "sky":         { "hex": "#6FA0C8", "name": "November sky", "note": "Proposed: terminal blue, info" },
    "fig":         { "hex": "#AE71C7", "name": "Fig", "note": "Proposed: plum lightened (terminal magenta, types)" },
    "juniper":     { "hex": "#5FB3A3", "name": "Juniper", "note": "Proposed: terminal cyan" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "warm_orange",
      "secondary":   "roast",
      "tertiary":    "pumpkin",
      "accent":      "harvest",
      "accent_alt":  "amber",
      "highlight":   "plum",
      "deep":        "walnut",
      "text_accent": "butter"
    },
    "ui": {
      "text_light":     "white",
      "text_dark":      "charcoal",
      "background":     "hearth",
      "foreground":     "linen",
      "surface":        "oak",
      "line_highlight": "oak",
      "border":         "oak",
      "muted":          "oatmeal",
      "selection":      "roast",
      "cursor":         "pumpkin"
    },
    "status": {
      "success": "cream",
      "warning": "harvest",
      "error":   "roast",
      "info":    "sky"
    },
    "syntax": {
      "comment":  { "color": "oatmeal", "style": "italic" },
      "keyword":  "amber",
      "string":   "sage",
      "number":   "harvest",
      "constant": "harvest",
      "function": "pumpkin",
      "type":     "fig",
      "variable": "linen",
      "invalid":  "cranberry"
    },
    "terminal": {
      "black":         "oak",
      "red":           "cranberry",
      "green":         "sage",
      "yellow":        "harvest",
      "blue":          "sky",
      "magenta":       "fig",
      "cyan":          "juniper",
      "white":         "linen",
      "bright_black":  "oatmeal",
      "bright_red":    "pumpkin",
      "bright_yellow": "butter",
      "bright_white":  "white"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "🍂",
    "root":       "🍂",
    "path":       "🍗🍗🍗",
    "folder":     "🦃",
    "home":       "🍁",
    "git":        "🌽",
    "exec_time":  "🍽️",
    "clock":      "🦃",
    "battery":    "🍂",
    "status_ok":  "🍁",
    "status_err": "🍁",
    "language":   "🍁",
    "lang": {
      "node":    "🦃",
      "npm":     "🥧",
      "python":  "🍂",
      "dotnet":  "🍂",
      "rust":    "🍂",
      "angular": "🍠",
      "julia":   "🍂",
      "azfunc":  "🍂",
      "aws":     "🍂"
    },
    "os": {
      "linux":   "🍁",
      "macos":   "🍂",
      "windows": "🦃"
    },
    "pool": ["🍽️", "🍴", "🌰", "🍊", "🥕", "🥔", "🥧", "🍠", "🌽", "☕", "🧣", "🧤", "🏈", "🙏", "🥂", "🏡"]
  },

  // ── Per-program extras ──────────────────────────────────────────────────
  "targets": {
    "vscode": {
      "status_bar": "brand.secondary"
    }
  },

  // ── Light mode ──────────────────────────────────────────────────────────
  "modes": {
    // Drafted by tools/New-LightMode.ps1 from the dark colours: tune freely.
    "light": {
      "palette": {
        "warm_orange_ink": { "hex": "#B34700", "name": "Warm orange (light-mode ink)", "note": "Proposed: light mode" },
        "light_page": { "hex": "#F8F2ED", "name": "Light-mode page", "note": "Proposed: light mode" },
        "light_ink": { "hex": "#3E362E", "name": "Light-mode ink", "note": "Proposed: light mode" },
        "light_panel": { "hex": "#F3E6DE", "name": "Light-mode panel", "note": "Proposed: light mode" },
        "light_current_line": { "hex": "#F5EAE3", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#E4CAB8", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#6E6762", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#D4A98C", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "harvest_ink": { "hex": "#7E6607", "name": "Harvest gold (light-mode ink)", "note": "Proposed: light mode" },
        "cream_ink": { "hex": "#007193", "name": "Cream (light-mode ink)", "note": "Proposed: light mode" },
        "sky_ink": { "hex": "#3A6D97", "name": "November sky (light-mode ink)", "note": "Proposed: light mode" },
        "amber_ink": { "hex": "#935D07", "name": "Amber (light-mode ink)", "note": "Proposed: light mode" },
        "sage_ink": { "hex": "#626D41", "name": "Sage (light-mode ink)", "note": "Proposed: light mode" },
        "pumpkin_ink": { "hex": "#A05512", "name": "Pumpkin orange (light-mode ink)", "note": "Proposed: light mode" },
        "fig_ink": { "hex": "#9447B3", "name": "Fig (light-mode ink)", "note": "Proposed: light mode" },
        "cranberry_ink": { "hex": "#C1352E", "name": "Cranberry (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#87807B", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#938B85", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" },
        "butter_ink": { "hex": "#6E6C00", "name": "Butter yellow (light-mode ink)", "note": "Proposed: light mode" },
        "juniper_ink": { "hex": "#377368", "name": "Juniper (light-mode ink)", "note": "Proposed: light mode" }
      },
      "colors": {
        "brand": {
          "line": "warm_orange_ink"
        },
        "ui": {
          "background": "light_page",
          "foreground": "light_ink",
          "surface": "light_panel",
          "line_highlight": "light_current_line",
          "border": "light_border",
          "muted": "light_muted_text",
          "selection": "light_selection",
          "cursor": "warm_orange_ink",
          "accent": "harvest_ink"
        },
        "status": {
          "success": "cream_ink",
          "warning": "harvest_ink",
          "error": "roast",
          "info": "sky_ink"
        },
        "syntax": {
          "comment": { "color": "light_muted_text", "style": "italic" },
          "keyword": "amber_ink",
          "string": "sage_ink",
          "number": "harvest_ink",
          "constant": "harvest_ink",
          "function": "pumpkin_ink",
          "type": "fig_ink",
          "variable": "light_ink",
          "parameter": "light_ink",
          "property": "light_ink",
          "operator": "light_ink",
          "punctuation": "light_ink",
          "tag": "amber_ink",
          "attribute": "pumpkin_ink",
          "regex": "sage_ink",
          "invalid": "cranberry_ink"
        },
        "terminal": {
          "background": "light_page",
          "foreground": "light_ink",
          "cursor": "warm_orange_ink",
          "selection": "light_selection",
          "black": "light_ink",
          "bright_black": "light_muted_text",
          "white": "light_terminal_white",
          "bright_white": "light_terminal_bright_white",
          "red": "cranberry_ink",
          "bright_red": "pumpkin_ink",
          "green": "sage_ink",
          "bright_green": "sage_ink",
          "yellow": "harvest_ink",
          "bright_yellow": "butter_ink",
          "blue": "sky_ink",
          "bright_blue": "sky_ink",
          "magenta": "fig_ink",
          "bright_magenta": "fig_ink",
          "cyan": "juniper_ink",
          "bright_cyan": "juniper_ink"
        }
      },
      "targets": {
        "vscode": { "accent": "ui.accent" }
      }
    }
  }
}
