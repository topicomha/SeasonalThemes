{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "May",
  "name": "May Flowers",
  "tagline": "Emerald meadows, Mother's Day bouquets and a Memorial Day cookout",
  "description": [
    "May brings three things together: spring in full bloom, Mother's Day and Memorial Day.",
    "The palette is emerald (May's birthstone), buttercup yellow, cornflower blue, lavender and meadow green. The icons mix bees and butterflies, bouquets and ribbons, doves and medals, and a backyard BBQ."
  ],
  "mood": ["bright", "grateful", "blooming", "celebratory"],
  "keywords": ["flower meadow", "bouquet", "emerald", "cornflowers", "backyard barbecue", "flags", "doves"],
  "holidays": [
    { "name": "Mother's Day", "date": "05-11", "note": "2nd Sunday" },
    { "name": "Memorial Day", "date": "05-25", "note": "last Monday" }
  ],
  "links": [
    { "title": "Emojipedia: Spring", "url": "https://emojipedia.org/spring" }
  ],
  "ideas": [
    "The old battery segment used May's own colours for charging / discharging / full",
    "More Mother's Day icons: 💐 🎁 🎀 ❤️"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "buttercup":  { "hex": "#FCDC3B", "name": "Buttercup yellow" },
    "cornflower": { "hex": "#6495ED", "name": "Cornflower blue" },
    "meadow":     { "hex": "#4CBB17", "name": "Meadow green" },
    "lavender":   { "hex": "#B57EDC", "name": "Lavender" },
    "emerald":    { "hex": "#50C878", "name": "Emerald", "note": "May's birthstone" },
    "navy":       { "hex": "#000080", "name": "Navy" },
    "soil":       { "hex": "#5D4037", "name": "Rich soil" },
    "white":      { "hex": "#FFFFFF", "name": "White" },
    "dusk":       { "hex": "#141C2B", "name": "May dusk", "note": "Proposed: editor and terminal background" },
    "twilight":   { "hex": "#202A3D", "name": "Twilight", "note": "Proposed: panels, borders, current line" },
    "petal":      { "hex": "#F3F0E6", "name": "Daisy petal", "note": "Proposed: editor text" },
    "mist":       { "hex": "#9AA4B5", "name": "Morning mist", "note": "Proposed: comments, muted text" },
    "poppy":      { "hex": "#E8646A", "name": "Poppy red", "note": "Proposed: terminal red, invalid code (poppies for Memorial Day)" },
    "grill":      { "hex": "#F59E5B", "name": "Grill ember", "note": "Proposed: keywords" },
    "robin_egg":  { "hex": "#6FD3DB", "name": "Robin's egg", "note": "Proposed: terminal cyan" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "buttercup",
      "secondary":   "cornflower",
      "tertiary":    "meadow",
      "accent":      "lavender",
      "accent_alt":  "emerald",
      "highlight":   "lavender",
      "deep":        "cornflower",
      "text_accent": "navy",
      "line":        "meadow"
    },
    "ui": {
      "text_light":     "white",
      "text_dark":      "navy",
      "background":     "dusk",
      "foreground":     "petal",
      "surface":        "twilight",
      "line_highlight": "twilight",
      "border":         "twilight",
      "muted":          "mist",
      "selection":      "navy",
      "cursor":         "buttercup"
    },
    "status": {
      "success": "cornflower",
      "warning": "buttercup",
      "error":   "lavender",
      "info":    "cornflower"
    },
    "syntax": {
      "comment":  { "color": "mist", "style": "italic" },
      "keyword":  "grill",
      "string":   "emerald",
      "number":   "buttercup",
      "constant": "buttercup",
      "function": "cornflower",
      "type":     "lavender",
      "variable": "petal",
      "invalid":  "poppy"
    },
    "terminal": {
      "black":         "twilight",
      "red":           "poppy",
      "green":         "emerald",
      "yellow":        "buttercup",
      "blue":          "cornflower",
      "magenta":       "lavender",
      "cyan":          "robin_egg",
      "white":         "petal",
      "bright_black":  "mist",
      "bright_red":    "grill",
      "bright_green":  "meadow",
      "bright_white":  "white"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "🕊️",
    "root":       "🕊️",
    "path":       "🎖️",
    "folder":     "🎖️",
    "home":       "🫡",
    "git":        "☀️",
    "exec_time":  "🌞",
    "clock":      "🌭🍔🥩",
    "battery":    "🍢",
    "status_ok":  "🌻",
    "status_err": "🐞",
    "language":   "🌻",
    "lang": {
      "node":    "🐝",
      "npm":     "🐝",
      "yarn":    "🌈",
      "python":  "🦋",
      "java":    "🎁",
      "dotnet":  "🎀",
      "go":      "🇺🇸",
      "rust":    "🍖",
      "dart":    "❤️",
      "angular": "🍔",
      "julia":   "💐",
      "ruby":    "🔥",
      "azfunc":  "✨",
      "aws":     "🌭",
      "kubectl": "🫡"
    },
    "os": {
      "linux":   "🐧",
      "macos":   "🍎",
      "windows": "🪟"
    },
    "pool": ["🪇", "🌽", "🥩", "🍔", "💐", "🎀", "🎁", "🌷", "🌼", "🐝", "🦋", "🇺🇸", "🎖️", "👨‍🍳"]
  },

  // ── Per-program extras ──────────────────────────────────────────────────
  "targets": {
    "oh-my-posh": {
      "time_format": "1/2 3:04 PM"
    }
  },

  // ── Light mode ──────────────────────────────────────────────────────────
  "modes": {
    // Drafted by tools/New-LightMode.ps1 from the dark colours: tune freely.
    "light": {
      "palette": {
        "meadow_ink": { "hex": "#358410", "name": "Meadow green (light-mode ink)", "note": "Proposed: light mode" },
        "light_page": { "hex": "#FFFDF1", "name": "Light-mode page", "note": "Proposed: light mode" },
        "light_ink": { "hex": "#262176", "name": "Light-mode ink", "note": "Proposed: light mode" },
        "light_panel": { "hex": "#FFFAE6", "name": "Light-mode panel", "note": "Proposed: light mode" },
        "light_current_line": { "hex": "#FFFBE9", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#FEF5C8", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#726E9E", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#8C8CC6", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "buttercup_ink": { "hex": "#887202", "name": "Buttercup yellow (light-mode ink)", "note": "Proposed: light mode" },
        "lavender_ink": { "hex": "#9B50D0", "name": "Lavender (light-mode ink)", "note": "Proposed: light mode" },
        "cornflower_ink": { "hex": "#2A6DE6", "name": "Cornflower blue (light-mode ink)", "note": "Proposed: light mode" },
        "grill_ink": { "hex": "#BA570B", "name": "Grill ember (light-mode ink)", "note": "Proposed: light mode" },
        "emerald_ink": { "hex": "#298347", "name": "Emerald (light-mode ink)", "note": "Proposed: light mode" },
        "poppy_ink": { "hex": "#DF262F", "name": "Poppy red (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#8783AA", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#9390AE", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" },
        "robin_egg_ink": { "hex": "#227F87", "name": "Robin's egg (light-mode ink)", "note": "Proposed: light mode" }
      },
      "colors": {
        "brand": {
          "line": "meadow_ink"
        },
        "ui": {
          "background": "light_page",
          "foreground": "light_ink",
          "surface": "light_panel",
          "line_highlight": "light_current_line",
          "border": "light_border",
          "muted": "light_muted_text",
          "selection": "light_selection",
          "cursor": "buttercup_ink",
          "accent": "lavender_ink"
        },
        "status": {
          "success": "cornflower_ink",
          "warning": "buttercup_ink",
          "error": "lavender_ink",
          "info": "cornflower_ink"
        },
        "syntax": {
          "comment": { "color": "light_muted_text", "style": "italic" },
          "keyword": "grill_ink",
          "string": "emerald_ink",
          "number": "buttercup_ink",
          "constant": "buttercup_ink",
          "function": "cornflower_ink",
          "type": "lavender_ink",
          "variable": "light_ink",
          "parameter": "light_ink",
          "property": "light_ink",
          "operator": "light_ink",
          "punctuation": "light_ink",
          "tag": "grill_ink",
          "attribute": "cornflower_ink",
          "regex": "emerald_ink",
          "invalid": "poppy_ink"
        },
        "terminal": {
          "background": "light_page",
          "foreground": "light_ink",
          "cursor": "buttercup_ink",
          "selection": "light_selection",
          "black": "light_ink",
          "bright_black": "light_muted_text",
          "white": "light_terminal_white",
          "bright_white": "light_terminal_bright_white",
          "red": "poppy_ink",
          "bright_red": "grill_ink",
          "green": "emerald_ink",
          "bright_green": "meadow_ink",
          "yellow": "buttercup_ink",
          "bright_yellow": "buttercup_ink",
          "blue": "cornflower_ink",
          "bright_blue": "cornflower_ink",
          "magenta": "lavender_ink",
          "bright_magenta": "lavender_ink",
          "cyan": "robin_egg_ink",
          "bright_cyan": "robin_egg_ink"
        }
      },
      "targets": {
        "vscode": { "accent": "ui.accent" }
      }
    }
  }
}
