{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "╭─",
          "template": "🍂 {{ .Name }} ",
          "foreground": "#FFFFFF",
          "background": "#D35400",
          "type": "shell",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<parentBackground>🍂</>  ",
          "foreground": "#FFFB38",
          "background": "#A04000",
          "type": "root",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": " 🦃 ",
            "home_icon": " 🍁 ",
            "style": "folder"
          },
          "template": " 🍗🍗🍗 {{ .Path }} ",
          "foreground": "#2D3436",
          "powerline_symbol": "",
          "background": "#E67E22",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_icon": "🌽 ",
            "cache_duration": "none",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} ✏️ {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#A04000> 📂 {{ .Staging.String }}</>{{ end }} ",
          "foreground": "#2D3436",
          "powerline_symbol": "",
          "background": "#F1C40F",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#F39C12{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#F1C40F{{ end }}",
            "{{ if gt .Ahead 0 }}#F39C12{{ end }}",
            "{{ if gt .Behind 0 }}#F39C12{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none",
            "style": "roundrock",
            "threshold": 0
          },
          "trailing_diamond": "",
          "template": " 🍽️ {{ .FormattedMs }} ",
          "foreground": "#FFFFFF",
          "background": "#523422",
          "type": "executiontime",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "fetch_package_manager": true,
            "npm_icon": " 🥧 ",
            "yarn_icon": " 🍁 "
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🦃 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "foreground": "#FFFFFF",
          "background": "#8E44AD",
          "type": "node",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🍂 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "foreground": "#FFFFFF",
          "background": "#D35400",
          "type": "python",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🍁 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#2D3436",
          "background": "#E67E22",
          "type": "java",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🍂 {{ if .Unsupported }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#FFFFFF",
          "background": "#A04000",
          "type": "dotnet",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🍁 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#2D3436",
          "background": "#F39C12",
          "type": "go",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🍂 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#FFFFFF",
          "background": "#D35400",
          "type": "rust",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": " ",
          "trailing_diamond": " ",
          "template": "🍁 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#2D3436",
          "background": "#E67E22",
          "type": "dart",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": " ",
          "trailing_diamond": " ",
          "template": "🍠 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#2D3436",
          "background": "#F1C40F",
          "type": "angular",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": " ",
          "trailing_diamond": " ",
          "template": "🍁 {{ if .Error }}{{ .Error }}{{ else }}Nx {{ .Full }}{{ end }}",
          "foreground": "#FFFFFF",
          "background": "#A04000",
          "type": "nx",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": " ",
          "trailing_diamond": " ",
          "template": "🍂 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#FFFFFF",
          "background": "#8E44AD",
          "type": "julia",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🍁 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#2D3436",
          "background": "#F39C12",
          "type": "ruby",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🍂 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#2D3436",
          "background": "#F1C40F",
          "type": "azfunc",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🍂 {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "foreground": "#FFFFFF",
          "background": "#A04000",
          "type": "aws",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "🍁 {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}",
          "foreground": "#FFFFFF",
          "background": "#D35400",
          "type": "kubectl",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "linux": "🍁",
            "macos": "🍂",
            "windows": "🦃"
          },
          "leading_diamond": "",
          "trailing_diamond": "<transparent,background></>",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "#FFFFFF",
          "background": "#8E44AD",
          "type": "os",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "charged_icon": "🔋 ",
            "charging_icon": "⚡️ ",
            "discharging_icon": "🍂 "
          },
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}🔋 ",
          "foreground": "#262626",
          "powerline_symbol": "",
          "background": "#F1C40F",
          "type": "battery",
          "style": "powerline",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#b8e994{{end}}",
            "{{if eq \"Discharging\" .State.String}}#fff34e{{end}}",
            "{{if eq \"Full\" .State.String}}#33DD2D{{end}}"
          ],
          "invert_powerline": true
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "2006-01-02 3:04:05"
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " 🦃 {{ .CurrentDate | date .Format }} ",
          "foreground": "#2D3436",
          "background": "#F1C40F",
          "type": "time",
          "style": "diamond",
          "invert_powerline": true
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "⌂──",
          "foreground": "#B34700",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "{{ if gt .Code 0 }}🍁{{ else }}🍁{{ end }}  ",
          "foreground": "#007193",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#A04000{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
