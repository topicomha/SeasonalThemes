{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "June",
  "name": "Summer Vacation",
  "tagline": "Beach colours, sunglasses and the carefree first days of summer",
  "description": [
    "June celebrates the beginning of summer with bright beach colours, vacation vibes and outdoor activity icons.",
    "It brings the carefree feeling of summer vacation with cool sky and turquoise blues, mint, sunny pale yellow and beach-towel pinks."
  ],
  "mood": ["carefree", "sunny", "cool", "playful"],
  "keywords": ["beach umbrella", "sunglasses", "surfing", "desert island", "watermelon", "ocean waves", "graduation caps"],
  "holidays": [
    { "name": "Father's Day", "date": "06-15", "note": "3rd Sunday" },
    { "name": "Juneteenth", "date": "06-19" },
    { "name": "Summer solstice", "date": "06-21", "note": "around the 21st" }
  ],
  "links": [
    { "title": "Emojipedia: Summer", "url": "https://emojipedia.org/summer" },
    { "title": "Emojipedia: Graduation", "url": "https://emojipedia.org/graduation" }
  ],
  "ideas": [
    "More summer activities: 🏊 swimming, ⛵ sailboat, 🏐 volleyball",
    "Summer treats: 🍦 ice cream, 🍹 tropical drink",
    "👙 bikini or 🩴 flip-flops for summer vacation items",
    "🎓 graduation caps for a graduation-week variant",
    "The old theme coloured execution time yellow over 300 ms and red over 1 s; the shared layout could bring that back for every month"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "sky":       { "hex": "#87CEEB", "name": "Sky blue" },
    "turquoise": { "hex": "#40E0D0", "name": "Turquoise" },
    "mint":      { "hex": "#98FB98", "name": "Mint green" },
    "lemonade":  { "hex": "#FFFFE0", "name": "Lemonade yellow" },
    "flamingo":  { "hex": "#FFBCD9", "name": "Flamingo pink" },
    "towel":     { "hex": "#FFB6C1", "name": "Beach-towel pink" },
    "shallows":  { "hex": "#87CEFA", "name": "Light blue shallows" },
    "black":     { "hex": "#000000", "name": "Black" },
    "white":     { "hex": "#FFFFFF", "name": "White" },
    "coral":     { "hex": "#FF6F61", "name": "Coral", "note": "New: the old theme had no error colour" },
    "night_surf": { "hex": "#0D1B2A", "name": "Night surf", "note": "Proposed: editor and terminal background" },
    "boardwalk": { "hex": "#1B2E42", "name": "Boardwalk", "note": "Proposed: panels, borders, current line" },
    "sea_foam":  { "hex": "#F1F5F9", "name": "Sea foam", "note": "Proposed: editor text" },
    "driftwood": { "hex": "#93A8BD", "name": "Driftwood", "note": "Proposed: comments, muted text" },
    "sand":      { "hex": "#FFE08A", "name": "Warm sand", "note": "Proposed: terminal yellow, numbers" },
    "orchid":    { "hex": "#C9A0DC", "name": "Orchid", "note": "Proposed: terminal magenta, types" },
    "lagoon":    { "hex": "#2A6F97", "name": "Lagoon", "note": "Proposed: selection" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "sky",
      "secondary":   "turquoise",
      "tertiary":    "mint",
      "accent":      "lemonade",
      "accent_alt":  "towel",
      "highlight":   "flamingo",
      "deep":        "shallows",
      "text_accent": "black"
    },
    "ui": {
      "text_light":     "white",
      "text_dark":      "black",
      "background":     "night_surf",
      "foreground":     "sea_foam",
      "surface":        "boardwalk",
      "line_highlight": "boardwalk",
      "border":         "boardwalk",
      "muted":          "driftwood",
      "selection":      "lagoon",
      "cursor":         "sky"
    },
    "status": {
      "success": "mint",
      "warning": "sand",
      "error":   "coral",
      "info":    "sky"
    },
    "syntax": {
      "comment":  { "color": "driftwood", "style": "italic" },
      "keyword":  "flamingo",
      "string":   "mint",
      "number":   "sand",
      "constant": "sand",
      "function": "turquoise",
      "type":     "sky",
      "variable": "sea_foam",
      "invalid":  "coral"
    },
    "terminal": {
      "black":         "boardwalk",
      "red":           "coral",
      "green":         "mint",
      "yellow":        "sand",
      "blue":          "sky",
      "magenta":       "orchid",
      "cyan":          "turquoise",
      "white":         "sea_foam",
      "bright_black":  "driftwood",
      "bright_red":    "towel",
      "bright_yellow": "lemonade",
      "bright_blue":   "shallows",
      "bright_magenta": "flamingo",
      "bright_white":  "white"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "😎",
    "root":       "🏄",
    "path":       "🕶️",
    "folder":     "🏖️",
    "home":       "🏝️",
    "git":        "🌞",
    "exec_time":  "🏊",
    "clock":      "⛱️",
    "battery":    "🥵",
    "status_ok":  "🍉",
    "status_err": "🌋",
    "language":   "🌊",
    "lang": {
      "node":    "🍉",
      "npm":     "🍦",
      "yarn":    "🍹",
      "java":    "🏐",
      "go":      "🐚",
      "rust":    "🦀",
      "dart":    "🐬",
      "ruby":    "🍓",
      "kubectl": "⛵"
    },
    "os": {
      "linux":   "🐚",
      "macos":   "🍍",
      "windows": "🏄"
    },
    "pool": ["🏊", "⛵", "🏐", "🍦", "🍹", "👙", "🩴", "🎓", "📜", "🐬", "🥥", "🌺", "🏖️", "🌊"]
  },

  // ── Light mode ──────────────────────────────────────────────────────────
  "modes": {
    // Drafted by tools/New-LightMode.ps1 from the dark colours: tune freely.
    "light": {
      "palette": {
        "sky_ink": { "hex": "#1B7AA2", "name": "Sky blue (light-mode ink)", "note": "Proposed: light mode" },
        "light_page": { "hex": "#F7FCFE", "name": "Light-mode page", "note": "Proposed: light mode" },
        "light_ink": { "hex": "#141F23", "name": "Light-mode ink", "note": "Proposed: light mode" },
        "light_panel": { "hex": "#EFF9FC", "name": "Light-mode panel", "note": "Proposed: light mode" },
        "light_current_line": { "hex": "#F2FAFD", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#DDF1F9", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#6C7375", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#9FBED0", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "lemonade_ink": { "hex": "#757500", "name": "Lemonade yellow (light-mode ink)", "note": "Proposed: light mode" },
        "mint_ink": { "hex": "#058405", "name": "Mint green (light-mode ink)", "note": "Proposed: light mode" },
        "sand_ink": { "hex": "#926B00", "name": "Warm sand (light-mode ink)", "note": "Proposed: light mode" },
        "coral_ink": { "hex": "#E21400", "name": "Coral (light-mode ink)", "note": "Proposed: light mode" },
        "flamingo_ink": { "hex": "#E00061", "name": "Flamingo pink (light-mode ink)", "note": "Proposed: light mode" },
        "turquoise_ink": { "hex": "#157F75", "name": "Turquoise (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#81878A", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#8C9396", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" },
        "towel_ink": { "hex": "#E50023", "name": "Beach-towel pink (light-mode ink)", "note": "Proposed: light mode" },
        "shallows_ink": { "hex": "#0876BB", "name": "Light blue shallows (light-mode ink)", "note": "Proposed: light mode" },
        "orchid_ink": { "hex": "#9C51BF", "name": "Orchid (light-mode ink)", "note": "Proposed: light mode" }
      },
      "colors": {
        "brand": {
          "line": "sky_ink"
        },
        "ui": {
          "background": "light_page",
          "foreground": "light_ink",
          "surface": "light_panel",
          "line_highlight": "light_current_line",
          "border": "light_border",
          "muted": "light_muted_text",
          "selection": "light_selection",
          "cursor": "sky_ink",
          "accent": "lemonade_ink"
        },
        "status": {
          "success": "mint_ink",
          "warning": "sand_ink",
          "error": "coral_ink",
          "info": "sky_ink"
        },
        "syntax": {
          "comment": { "color": "light_muted_text", "style": "italic" },
          "keyword": "flamingo_ink",
          "string": "mint_ink",
          "number": "sand_ink",
          "constant": "sand_ink",
          "function": "turquoise_ink",
          "type": "sky_ink",
          "variable": "light_ink",
          "parameter": "light_ink",
          "property": "light_ink",
          "operator": "light_ink",
          "punctuation": "light_ink",
          "tag": "flamingo_ink",
          "attribute": "turquoise_ink",
          "regex": "mint_ink",
          "invalid": "coral_ink"
        },
        "terminal": {
          "background": "light_page",
          "foreground": "light_ink",
          "cursor": "sky_ink",
          "selection": "light_selection",
          "black": "light_ink",
          "bright_black": "light_muted_text",
          "white": "light_terminal_white",
          "bright_white": "light_terminal_bright_white",
          "red": "coral_ink",
          "bright_red": "towel_ink",
          "green": "mint_ink",
          "bright_green": "mint_ink",
          "yellow": "sand_ink",
          "bright_yellow": "lemonade_ink",
          "blue": "sky_ink",
          "bright_blue": "shallows_ink",
          "magenta": "orchid_ink",
          "bright_magenta": "flamingo_ink",
          "cyan": "turquoise_ink",
          "bright_cyan": "turquoise_ink"
        }
      },
      "targets": {
        "vscode": { "accent": "ui.accent" }
      }
    }
  }
}
