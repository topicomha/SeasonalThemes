{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "August",
  "name": "Late Summer",
  "tagline": "Golden sun, turquoise water and the first of the harvest",
  "description": [
    "August captures late summer: warm golden tones, beach vibes and the first hints of harvest.",
    "Bright summer colours (sun gold, sunset orange, turquoise water) sit next to the sea greens and wheat of the coming harvest season."
  ],
  "mood": ["sunny", "relaxed", "warm", "golden"],
  "keywords": ["sunflower field", "beach umbrella", "palm trees", "turquoise water", "wheat field", "sunset", "watermelon"],
  "links": [
    { "title": "Emojipedia: Summer", "url": "https://emojipedia.org/summer" }
  ],
  "ideas": [
    "More summer fruit for the harvest: 🍇 🍑 🍓",
    "Sunset gradient colours for a late summer evening feel",
    "🏊 swimming icons for a summer recreation theme",
    "The old theme coloured execution time yellow over 300 ms and red over 1 s; the shared layout could bring that back for every month"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "golden":    { "hex": "#FFD700", "name": "Golden sun" },
    "sunset":    { "hex": "#FF8C00", "name": "Sunset orange" },
    "turquoise": { "hex": "#40E0D0", "name": "Turquoise water" },
    "sea_green": { "hex": "#2E8B57", "name": "Sea green" },
    "khaki":     { "hex": "#F0E68C", "name": "Sand khaki" },
    "mustard":   { "hex": "#FFDB58", "name": "Mustard" },
    "teal":      { "hex": "#008080", "name": "Deep teal" },
    "seafoam":   { "hex": "#98FB98", "name": "Seafoam" },
    "sunburn":   { "hex": "#FF0000", "name": "Sunburn red" },
    "cloud":     { "hex": "#FFFFFF", "name": "Cloud white" },
    "black":     { "hex": "#000000", "name": "Black" },
    "lagoon":    { "hex": "#0F2E2E", "name": "Night lagoon", "note": "Proposed: editor and terminal background" },
    "tide":      { "hex": "#1A4242", "name": "Tide pool", "note": "Proposed: panels, borders, current line" },
    "driftwood": { "hex": "#8FA8A0", "name": "Driftwood", "note": "Proposed: comments, muted text" },
    "shell":     { "hex": "#D8D2C0", "name": "Seashell", "note": "Proposed: terminal white" },
    "ocean":     { "hex": "#4AA3DF", "name": "Ocean blue", "note": "Proposed: terminal blue, info" },
    "hibiscus":  { "hex": "#E27AB3", "name": "Hibiscus pink", "note": "Proposed: terminal magenta" },
    "coral":     { "hex": "#FF6B5B", "name": "Coral", "note": "Proposed: terminal red, invalid code" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "golden",
      "secondary":   "sunset",
      "tertiary":    "turquoise",
      "accent":      "sea_green",
      "accent_alt":  "mustard",
      "highlight":   "khaki",
      "deep":        "teal",
      "text_accent": "black"
    },
    "ui": {
      "text_light":     "cloud",
      "text_dark":      "black",
      "background":     "lagoon",
      "foreground":     "cloud",
      "surface":        "tide",
      "line_highlight": "tide",
      "border":         "tide",
      "muted":          "driftwood",
      "selection":      "sea_green",
      "cursor":         "golden"
    },
    "status": {
      "success": "seafoam",
      "warning": "mustard",
      "error":   "sunburn",
      "info":    "ocean"
    },
    "syntax": {
      "comment":  { "color": "driftwood", "style": "italic" },
      "keyword":  "sunset",
      "string":   "khaki",
      "number":   "turquoise",
      "constant": "turquoise",
      "function": "golden",
      "type":     "seafoam",
      "variable": "cloud",
      "invalid":  "coral"
    },
    "terminal": {
      "black":         "tide",
      "red":           "coral",
      "green":         "seafoam",
      "yellow":        "golden",
      "blue":          "ocean",
      "magenta":       "hibiscus",
      "cyan":          "turquoise",
      "white":         "shell",
      "bright_black":  "driftwood",
      "bright_red":    "sunset",
      "bright_yellow": "mustard",
      "bright_white":  "cloud"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "☀️",
    "root":       "🏖️",
    "path":       "🌻",
    "folder":     "🌴",
    "home":       "🏡",
    "git":        "🌾",
    "exec_time":  "🍦",
    "clock":      "🌅",
    "battery":    "🥵",
    "status_ok":  "🍉",
    "status_err": "🔥",
    "language":   "🌊",
    "lang": {
      "node":    "🍉",
      "npm":     "🍦",
      "yarn":    "🍑",
      "java":    "🌻",
      "go":      "🌻",
      "dart":    "🌻",
      "nx":      "🌻",
      "ruby":    "🌻",
      "kubectl": "🌻"
    },
    "os": {
      "linux":   "🐚",
      "macos":   "🌴",
      "windows": "🏄"
    },
    "pool": ["🐚", "🏊", "👡", "😎", "🏝️", "🕶️", "👙", "🌞", "🍹", "🏄", "🩱", "🩴", "🩳", "🍨", "🧢", "🌄", "🌡️", "🥥", "🍇", "🍑", "🍓"]
  },

  // ── Per-program extras ──────────────────────────────────────────────────
  "targets": {
    "vscode": {
      "accent": "brand.tertiary"
    }
  },

  // ── Light mode ──────────────────────────────────────────────────────────
  "modes": {
    // Drafted by tools/New-LightMode.ps1 from the dark colours: tune freely.
    "light": {
      "palette": {
        "golden_ink": { "hex": "#877200", "name": "Golden sun (light-mode ink)", "note": "Proposed: light mode" },
        "light_page": { "hex": "#FFFCED", "name": "Light-mode page", "note": "Proposed: light mode" },
        "light_ink": { "hex": "#262000", "name": "Light-mode ink", "note": "Proposed: light mode" },
        "light_panel": { "hex": "#FFFADE", "name": "Light-mode panel", "note": "Proposed: light mode" },
        "light_current_line": { "hex": "#FFFBE3", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#FFF4B8", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#77735F", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#A1CBB3", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "turquoise_ink": { "hex": "#158177", "name": "Turquoise water (light-mode ink)", "note": "Proposed: light mode" },
        "seafoam_ink": { "hex": "#058605", "name": "Seafoam (light-mode ink)", "note": "Proposed: light mode" },
        "mustard_ink": { "hex": "#8E6F00", "name": "Mustard (light-mode ink)", "note": "Proposed: light mode" },
        "sunburn_ink": { "hex": "#E80000", "name": "Sunburn red (light-mode ink)", "note": "Proposed: light mode" },
        "ocean_ink": { "hex": "#2078B4", "name": "Ocean blue (light-mode ink)", "note": "Proposed: light mode" },
        "sunset_ink": { "hex": "#AE5F00", "name": "Sunset orange (light-mode ink)", "note": "Proposed: light mode" },
        "khaki_ink": { "hex": "#807411", "name": "Sand khaki (light-mode ink)", "note": "Proposed: light mode" },
        "coral_ink": { "hex": "#E41600", "name": "Coral (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#8C8773", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#97937D", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" },
        "hibiscus_ink": { "hex": "#D12D87", "name": "Hibiscus pink (light-mode ink)", "note": "Proposed: light mode" }
      },
      "colors": {
        "brand": {
          "line": "golden_ink"
        },
        "ui": {
          "background": "light_page",
          "foreground": "light_ink",
          "surface": "light_panel",
          "line_highlight": "light_current_line",
          "border": "light_border",
          "muted": "light_muted_text",
          "selection": "light_selection",
          "cursor": "golden_ink",
          "accent": "turquoise_ink"
        },
        "status": {
          "success": "seafoam_ink",
          "warning": "mustard_ink",
          "error": "sunburn_ink",
          "info": "ocean_ink"
        },
        "syntax": {
          "comment": { "color": "light_muted_text", "style": "italic" },
          "keyword": "sunset_ink",
          "string": "khaki_ink",
          "number": "turquoise_ink",
          "constant": "turquoise_ink",
          "function": "golden_ink",
          "type": "seafoam_ink",
          "variable": "light_ink",
          "parameter": "light_ink",
          "property": "light_ink",
          "operator": "light_ink",
          "punctuation": "light_ink",
          "tag": "sunset_ink",
          "attribute": "golden_ink",
          "regex": "khaki_ink",
          "invalid": "coral_ink"
        },
        "terminal": {
          "background": "light_page",
          "foreground": "light_ink",
          "cursor": "golden_ink",
          "selection": "light_selection",
          "black": "light_ink",
          "bright_black": "light_muted_text",
          "white": "light_terminal_white",
          "bright_white": "light_terminal_bright_white",
          "red": "coral_ink",
          "bright_red": "sunset_ink",
          "green": "seafoam_ink",
          "bright_green": "seafoam_ink",
          "yellow": "golden_ink",
          "bright_yellow": "mustard_ink",
          "blue": "ocean_ink",
          "bright_blue": "ocean_ink",
          "magenta": "hibiscus_ink",
          "bright_magenta": "hibiscus_ink",
          "cyan": "turquoise_ink",
          "bright_cyan": "turquoise_ink"
        }
      },
      "targets": {
        "vscode": { "accent": "ui.accent" }
      }
    }
  }
}
