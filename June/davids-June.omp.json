{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "\u256d\u2500\ue0b6",
          "template": "😎 {{ .Name }} ",
          "foreground": "#000000",
          "background": "#87CEEB",
          "type": "shell",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<parentBackground>🏄</> \uf292 ",
          "foreground": "#000000",
          "background": "#40E0D0",
          "type": "root",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": " 🏖️ ",
            "home_icon": " 🏝️ ",
            "style": "folder"
          },
          "template": " 🕶️ {{ .Path }} ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "background": "#98FB98",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_icon": "🌞 ",
            "cache_duration": "none",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} ✏️ {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#40E0D0> 📂 {{ .Staging.String }}</>{{ end }} ",
          "background": "#FFFFE0",
          "foreground": "#000000",
          "type": "git",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_default": false
          },
          "foreground": "#000000",
          "background": "#FFBCD9",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "type": "python",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "thresholds": [
              {
                "foreground": "#FFFF00",
                "value": 300
              },
              {
                "foreground": "#FF0000",
                "value": 1000
              }
            ]
          },
          "template": " \uf252 {{ .FormattedMs }}s ",
          "foreground": "#000000",
          "background": "#87CEFA",
          "type": "executiontime",
          "style": "powerline"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "trailing_diamond": "\ue0b4\u2500\u2500\u2500\u256e",
          "template": " {{ if eq .Status \"Success\" }}🍉{{ else }}🌋{{ end }} ",
          "foreground": "#000000",
          "background": "#FFB6C1",
          "type": "status",
          "style": "diamond"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\u2570\u2500\ue0b6 ",
          "foreground": "#87CEEB",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "final_space": true,
  "version": 2
}
