{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "December",
  "name": "Holiday Season",
  "tagline": "Christmas trees, wrapped gifts and cookies for Santa",
  "description": [
    "December captures the winter holiday spirit: Christmas red, evergreen and forest greens with star gold and snow white.",
    "Trees, gifts, candles and Santa, with milk and cookies on the clock. After Christmas it turns into New Year's Eve: midnight black, fireworks blue, silver and champagne."
  ],
  "mood": ["festive", "cozy", "joyful", "sparkling"],
  "keywords": ["Christmas tree", "wrapped presents", "candlelight", "snowy village", "stockings", "fireworks", "champagne"],
  "holidays": [
    { "name": "Winter solstice", "date": "12-21", "note": "around the 21st" },
    { "name": "Christmas Eve", "date": "12-24" },
    { "name": "Christmas Day", "date": "12-25" },
    { "name": "New Year's Eve", "date": "12-31" }
  ],
  "links": [
    { "title": "Emojipedia: Christmas", "url": "https://emojipedia.org/christmas" },
    { "title": "Emojipedia: New Year's Eve", "url": "https://emojipedia.org/new-years-eve" }
  ],
  "ideas": [
    "More holiday icons: 🕯️ candle, 🦌 deer, 🧦 stocking",
    "🎅 Santa as the admin indicator",
    "Alternating red and green segments for a candy-cane effect",
    "☃️ snowman for system monitoring"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "christmas_red": { "hex": "#CC231E", "name": "Christmas red" },
    "evergreen":     { "hex": "#006400", "name": "Evergreen" },
    "forest":        { "hex": "#228B22", "name": "Forest green" },
    "gold":          { "hex": "#FFD700", "name": "Star gold" },
    "cranberry":     { "hex": "#8B0000", "name": "Cranberry" },
    "snow":          { "hex": "#FFFFFF", "name": "Snow white" },
    "frost":         { "hex": "#E0F8FF", "name": "Frost" },
    "charcoal":      { "hex": "#2D3436", "name": "Charcoal" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "christmas_red",
      "secondary":   "evergreen",
      "tertiary":    "forest",
      "accent":      "gold",
      "accent_alt":  "gold",
      "highlight":   "cranberry",
      "deep":        "snow",
      "text_accent": "gold"
    },
    "ui": {
      "text_light": "snow",
      "text_dark":  "charcoal"
    },
    "status": {
      "success": "frost",
      "error":   "evergreen"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "🎄",
    "root":       "🎅",
    "path":       "🎁",
    "folder":     "🎁",
    "home":       "🌟",
    "git":        "⭐",
    "exec_time":  "🕯️",
    "clock":      "🍪🥛",
    "battery":    "❄️",
    "status_ok":  "🧑‍🎄",
    "status_err": "🧑‍🎄",
    "language":   "🎄",
    "lang": {
      "yarn":    "🎅",
      "python":  "🎅",
      "java":    "🎁",
      "dotnet":  "⭐",
      "rust":    "🎅",
      "dart":    "🎁",
      "angular": "⭐",
      "julia":   "🎅",
      "ruby":    "🎁",
      "azfunc":  "⭐",
      "kubectl": "🎅"
    },
    "os": {
      "linux":   "🎄",
      "macos":   "🍎",
      "windows": "🎅"
    },
    "pool": ["🔔", "🕯️", "👼", "🤶", "☃️", "⛄", "🦌", "🍪", "🥛", "🧝", "🧦", "🛷", "🌨️", "🎀", "🌲", "🔥"]
  },

  // ── Date variants ───────────────────────────────────────────────────────
  "variants": [
    {
      "id": "new-years-eve",
      "name": "New Year's Eve",
      "from": "12-26",
      "to": "12-31",
      "tagline": "Midnight, fireworks and a champagne toast",
      "palette": {
        "midnight":  { "hex": "#000000", "name": "Midnight black" },
        "fireworks": { "hex": "#1E90FF", "name": "Fireworks blue" },
        "silver":    { "hex": "#808080", "name": "Silver" },
        "sparkler":  { "hex": "#FF4500", "name": "Sparkler orange" }
      },
      "colors": {
        "brand": {
          "primary":   "midnight",
          "secondary": "fireworks",
          "tertiary":  "silver",
          "highlight": "midnight",
          "deep":      "gold",
          "line":      "gold"
        },
        "ui": {
          "text_dark": "midnight"
        },
        "status": {
          "success": "snow",
          "error":   "sparkler"
        }
      },
      "icons": {
        "shell":      "🥳",
        "root":       "🥂",
        "path":       "🎇",
        "folder":     "🎇",
        "home":       "🥳",
        "exec_time":  "⏱️",
        "clock":      "🎉🥂",
        "status_ok":  "🕺",
        "status_err": "🕺",
        "language":   "🎉",
        "lang": {
          "yarn":    "🥂",
          "python":  "🥂",
          "java":    "🎇",
          "dotnet":  "⭐",
          "rust":    "🥂",
          "dart":    "🎇",
          "angular": "⭐",
          "julia":   "🥂",
          "ruby":    "🎇",
          "azfunc":  "⭐",
          "kubectl": "🥂"
        },
        "os": {
          "linux":   "🎉",
          "macos":   "🍎",
          "windows": "🍾"
        }
      },
      "targets": {
        "oh-my-posh": {
          "time_format": "2006-01-02 3:04:05 PM"
        }
      }
    }
  ]
}
