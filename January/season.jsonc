{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "January",
  "name": "Winter Wonderland",
  "tagline": "Crisp blue skies over fresh snow",
  "description": [
    "January captures the essence of winter with cool blues, whites and winter icons.",
    "It should feel like a crisp winter day over snow-covered landscapes: navy night, steel-blue ice, evergreen and a pale winter sky."
  ],
  "mood": ["crisp", "calm", "cold", "fresh"],
  "keywords": ["snow-covered mountains", "snowflakes", "snowman", "ski slope", "evergreen forest", "frozen lake", "hot tea"],
  "holidays": [
    { "name": "New Year's Day", "date": "01-01" },
    { "name": "Martin Luther King Jr. Day", "date": "01-15", "note": "3rd Monday" }
  ],
  "links": [
    { "title": "Emojipedia: Winter", "url": "https://emojipedia.org/winter" }
  ],
  "ideas": [
    "Lighter or darker blues depending on the terminal background",
    "❄️ snowflakes in more segments for a consistent winter feel",
    "A light blue battery segment for 'cold' winter energy"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "navy":      { "hex": "#000080", "name": "Winter night navy" },
    "steel":     { "hex": "#4682B4", "name": "Steel blue ice" },
    "evergreen": { "hex": "#2E8B57", "name": "Evergreen" },
    "sky":       { "hex": "#87CEEB", "name": "Winter sky" },
    "snow":      { "hex": "#FFFFFF", "name": "Snow white" },
    "black":     { "hex": "#000000", "name": "Black" },
    "ember":     { "hex": "#FF4500", "name": "Fireplace ember" },
    "polar":     { "hex": "#0B1B2E", "name": "Polar night", "note": "Proposed: editor and terminal background" },
    "drift":     { "hex": "#16304A", "name": "Snow drift shadow", "note": "Proposed: panels, borders, current line" },
    "ice":       { "hex": "#E8F1F8", "name": "Ice", "note": "Proposed: editor text" },
    "frost":     { "hex": "#8FA9C2", "name": "Frost", "note": "Proposed: comments, muted text" },
    "holly":     { "hex": "#E06C6C", "name": "Holly berry", "note": "Proposed: terminal red, invalid code" },
    "pine":      { "hex": "#6BC48A", "name": "Pine needle", "note": "Proposed: evergreen lightened (terminal green, strings)" },
    "candle":    { "hex": "#F2D06B", "name": "Candlelight", "note": "Proposed: terminal yellow, numbers" },
    "aurora":    { "hex": "#C49BE0", "name": "Aurora violet", "note": "Proposed: terminal magenta, types" },
    "glacier":   { "hex": "#7FDBDA", "name": "Glacier", "note": "Proposed: terminal cyan" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "navy",
      "secondary":   "steel",
      "tertiary":    "evergreen",
      "accent":      "sky",
      "accent_alt":  "sky",
      "highlight":   "navy",
      "deep":        "navy",
      "text_accent": "snow",
      "line":        "sky"
    },
    "ui": {
      "text_light":     "snow",
      "text_dark":      "black",
      "background":     "polar",
      "foreground":     "ice",
      "surface":        "drift",
      "line_highlight": "drift",
      "border":         "drift",
      "muted":          "frost",
      "selection":      "steel",
      "cursor":         "sky"
    },
    "status": {
      "success": "snow",
      "warning": "candle",
      "error":   "ember",
      "info":    "sky"
    },
    "syntax": {
      "comment":  { "color": "frost", "style": "italic" },
      "keyword":  "sky",
      "string":   "pine",
      "number":   "candle",
      "constant": "candle",
      "function": "glacier",
      "type":     "aurora",
      "variable": "ice",
      "invalid":  "holly"
    },
    "terminal": {
      "black":         "drift",
      "red":           "holly",
      "green":         "pine",
      "yellow":        "candle",
      "blue":          "sky",
      "magenta":       "aurora",
      "cyan":          "glacier",
      "white":         "ice",
      "bright_black":  "frost",
      "bright_red":    "ember",
      "bright_white":  "snow"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "❄️",
    "root":       "⛄",
    "path":       "🎿",
    "folder":     "🎿",
    "home":       "🏔️",
    "git":        "❄️",
    "exec_time":  "🧤🧣",
    "clock":      "❄️⛄",
    "battery":    "❄️",
    "status_ok":  "⛄",
    "status_err": "🥶",
    "language":   "🌬️",
    "lang": {
      "yarn":    "🌂",
      "python":  "⛄",
      "java":    "🎿",
      "dotnet":  "❄️",
      "rust":    "⛄",
      "dart":    "🎿",
      "angular": "❄️",
      "julia":   "⛄",
      "ruby":    "🎿",
      "azfunc":  "❄️",
      "kubectl": "⛄"
    },
    "os": {
      "linux":   "❄️",
      "macos":   "🍎",
      "windows": "⛄"
    },
    "pool": ["☃️", "⛷️", "🏂", "🍵", "🛷", "🌨️", "🌁", "🌲", "🧥", "🧣", "🧤", "☔", "🏔️"]
  },

  // ── Per-program extras ──────────────────────────────────────────────────
  "targets": {
    "vscode": {
      "status_bar": "brand.secondary"
    },
    "oh-my-posh": {
      "time_format": "2006-01-02 3:04:05 PM"
    }
  },

  // ── Light mode ──────────────────────────────────────────────────────────
  "modes": {
    // Drafted by tools/New-LightMode.ps1 from the dark colours: tune freely.
    "light": {
      "palette": {
        "sky_ink": { "hex": "#176A8C", "name": "Winter sky (light-mode ink)", "note": "Proposed: light mode" },
        "light_page": { "hex": "#EDEDF6", "name": "Light-mode page", "note": "Proposed: light mode" },
        "light_ink": { "hex": "#000013", "name": "Light-mode ink", "note": "Proposed: light mode" },
        "light_panel": { "hex": "#DEDEEE", "name": "Light-mode panel", "note": "Proposed: light mode" },
        "light_current_line": { "hex": "#E3E3F1", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#B8B8DB", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#62626E", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#ACC7DD", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "snow_ink": { "hex": "#636363", "name": "Snow white (light-mode ink)", "note": "Proposed: light mode" },
        "candle_ink": { "hex": "#7C5F0B", "name": "Candlelight (light-mode ink)", "note": "Proposed: light mode" },
        "ember_ink": { "hex": "#B83200", "name": "Fireplace ember (light-mode ink)", "note": "Proposed: light mode" },
        "pine_ink": { "hex": "#2C7044", "name": "Pine needle (light-mode ink)", "note": "Proposed: light mode" },
        "glacier_ink": { "hex": "#1F6D6D", "name": "Glacier (light-mode ink)", "note": "Proposed: light mode" },
        "aurora_ink": { "hex": "#8B3CC0", "name": "Aurora violet (light-mode ink)", "note": "Proposed: light mode" },
        "holly_ink": { "hex": "#BD2828", "name": "Holly berry (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#7C7C88", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#888894", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" }
      },
      "colors": {
        "brand": {
          "line": "sky_ink"
        },
        "ui": {
          "background": "light_page",
          "foreground": "light_ink",
          "surface": "light_panel",
          "line_highlight": "light_current_line",
          "border": "light_border",
          "muted": "light_muted_text",
          "selection": "light_selection",
          "cursor": "navy",
          "accent": "sky_ink"
        },
        "status": {
          "success": "snow_ink",
          "warning": "candle_ink",
          "error": "ember_ink",
          "info": "sky_ink"
        },
        "syntax": {
          "comment": { "color": "light_muted_text", "style": "italic" },
          "keyword": "sky_ink",
          "string": "pine_ink",
          "number": "candle_ink",
          "constant": "candle_ink",
          "function": "glacier_ink",
          "type": "aurora_ink",
          "variable": "light_ink",
          "parameter": "light_ink",
          "property": "light_ink",
          "operator": "light_ink",
          "punctuation": "light_ink",
          "tag": "sky_ink",
          "attribute": "glacier_ink",
          "regex": "pine_ink",
          "invalid": "holly_ink"
        },
        "terminal": {
          "background": "light_page",
          "foreground": "light_ink",
          "cursor": "navy",
          "selection": "light_selection",
          "black": "light_ink",
          "bright_black": "light_muted_text",
          "white": "light_terminal_white",
          "bright_white": "light_terminal_bright_white",
          "red": "holly_ink",
          "bright_red": "ember_ink",
          "green": "pine_ink",
          "bright_green": "pine_ink",
          "yellow": "candle_ink",
          "bright_yellow": "candle_ink",
          "blue": "sky_ink",
          "bright_blue": "sky_ink",
          "magenta": "aurora_ink",
          "bright_magenta": "aurora_ink",
          "cyan": "glacier_ink",
          "bright_cyan": "glacier_ink"
        }
      },
      "targets": {
        "vscode": { "accent": "ui.accent" }
      }
    }
  }
}
