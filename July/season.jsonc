{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "July",
  "name": "Independence Day",
  "tagline": "Stars, stripes and fireworks over a summer night",
  "description": [
    "July celebrates Independence Day with patriotic red, white and blue, stars, stripes and traditional American symbols.",
    "Navy and firebrick red, the flag's own Old Glory blue and red, Air Force blue and white, with fireworks, sparklers and the eagle."
  ],
  "mood": ["patriotic", "festive", "proud", "summery"],
  "keywords": ["fireworks", "American flag", "sparklers", "bald eagle", "Statue of Liberty", "backyard barbecue", "parade"],
  "holidays": [
    { "name": "Independence Day", "date": "07-04" }
  ],
  "links": [
    { "title": "Emojipedia: Independence Day", "url": "https://emojipedia.org/independence-day" }
  ],
  "ideas": [
    "Alternate red, white and blue segments for a striped effect",
    "🗽 Statue of Liberty as an alternative home icon",
    "🍖 meat on the bone for barbecue references",
    "The old theme coloured execution time yellow over 300 ms and red over 1 s; the shared layout could bring that back for every month"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "navy":        { "hex": "#000080", "name": "Navy blue" },
    "firebrick":   { "hex": "#B22222", "name": "Firebrick red" },
    "glory_blue":  { "hex": "#3C3B6E", "name": "Old Glory blue" },
    "glory_red":   { "hex": "#B31942", "name": "Old Glory red" },
    "air_force":   { "hex": "#0A3161", "name": "Air Force blue" },
    "stars":       { "hex": "#FFFFFF", "name": "Stars white" },
    "gold":        { "hex": "#FFD700", "name": "Sparkler gold" },
    "summer_night": { "hex": "#0B1026", "name": "Summer night", "note": "Proposed: editor and terminal background" },
    "bunting":     { "hex": "#1A2142", "name": "Bunting", "note": "Proposed: panels, borders, current line" },
    "starlight":   { "hex": "#F4F4F8", "name": "Starlight", "note": "Proposed: editor text" },
    "smoke":       { "hex": "#9AA3BE", "name": "Firework smoke", "note": "Proposed: comments, muted text" },
    "stripe_red":  { "hex": "#E5484D", "name": "Stripe red", "note": "Proposed: Old Glory red lightened (terminal red, keywords, invalid code)" },
    "liberty":     { "hex": "#6E8FCB", "name": "Liberty blue", "note": "Proposed: terminal blue, info" },
    "picnic":      { "hex": "#7FD18B", "name": "Picnic green", "note": "Proposed: terminal green, strings" },
    "roman":       { "hex": "#C792EA", "name": "Roman candle", "note": "Proposed: terminal magenta, types" },
    "fountain":    { "hex": "#6FD6E0", "name": "Fountain teal", "note": "Proposed: terminal cyan, functions" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "navy",
      "secondary":   "firebrick",
      "tertiary":    "glory_blue",
      "accent":      "glory_red",
      "accent_alt":  "gold",
      "highlight":   "stars",
      "deep":        "air_force",
      "text_accent": "stars",
      "line":        "gold"
    },
    "ui": {
      "text_light":     "stars",
      "text_dark":      "navy",
      "background":     "summer_night",
      "foreground":     "starlight",
      "surface":        "bunting",
      "line_highlight": "bunting",
      "border":         "bunting",
      "muted":          "smoke",
      "selection":      "glory_blue",
      "cursor":         "gold"
    },
    "status": {
      "success": "stars",
      "warning": "gold",
      "error":   "firebrick",
      "info":    "liberty"
    },
    "syntax": {
      "comment":  { "color": "smoke", "style": "italic" },
      "keyword":  "stripe_red",
      "string":   "picnic",
      "number":   "gold",
      "constant": "gold",
      "function": "fountain",
      "type":     "roman",
      "variable": "starlight",
      "invalid":  "stripe_red"
    },
    "terminal": {
      "black":         "bunting",
      "red":           "stripe_red",
      "green":         "picnic",
      "yellow":        "gold",
      "blue":          "liberty",
      "magenta":       "roman",
      "cyan":          "fountain",
      "white":         "starlight",
      "bright_black":  "smoke",
      "bright_white":  "stars"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "🎆",
    "root":       "🦅",
    "path":       "🎇",
    "folder":     "🎇",
    "home":       "🏛️",
    "git":        "🌟",
    "exec_time":  "🎺",
    "clock":      "🎉",
    "battery":    "🔥",
    "status_ok":  "🇺🇸",
    "status_err": "🧨",
    "language":   "⭐",
    "lang": {
      "node":    "🍉",
      "npm":     "🥧",
      "yarn":    "🎈",
      "python":  "🗽",
      "java":    "🍔",
      "dotnet":  "🎺",
      "go":      "🎈",
      "rust":    "🌭",
      "dart":    "🎯",
      "angular": "🦅",
      "nx":      "🎡",
      "julia":   "🎠",
      "ruby":    "🍒",
      "aws":     "🎈",
      "kubectl": "⚓"
    },
    "os": {
      "linux":   "🦅",
      "macos":   "🍎",
      "windows": "🗽"
    },
    "pool": ["🇺🇸", "🗽", "🎺", "🍖", "🎉", "⚾", "☀️", "🎈", "🎠", "🎡", "🔔", "🤠", "📜", "🎪"]
  },

  // ── Per-program extras ──────────────────────────────────────────────────
  "targets": {
    "vscode": {
      "status_bar": "brand.secondary",
      "accent": "brand.accent_alt"
    }
  },

  // ── Light mode ──────────────────────────────────────────────────────────
  "modes": {
    // Drafted by tools/New-LightMode.ps1 from the dark colours: tune freely.
    "light": {
      "palette": {
        "gold_ink": { "hex": "#756200", "name": "Sparkler gold (light-mode ink)", "note": "Proposed: light mode" },
        "light_page": { "hex": "#EDEDF6", "name": "Light-mode page", "note": "Proposed: light mode" },
        "light_panel": { "hex": "#DEDEEE", "name": "Light-mode panel", "note": "Proposed: light mode" },
        "light_current_line": { "hex": "#E3E3F1", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#B8B8DB", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#5A5AAD", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#A7A7BE", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "stars_ink": { "hex": "#636363", "name": "Stars white (light-mode ink)", "note": "Proposed: light mode" },
        "liberty_ink": { "hex": "#3C62A8", "name": "Liberty blue (light-mode ink)", "note": "Proposed: light mode" },
        "stripe_red_ink": { "hex": "#C31C21", "name": "Stripe red (light-mode ink)", "note": "Proposed: light mode" },
        "picnic_ink": { "hex": "#297133", "name": "Picnic green (light-mode ink)", "note": "Proposed: light mode" },
        "fountain_ink": { "hex": "#196D76", "name": "Fountain teal (light-mode ink)", "note": "Proposed: light mode" },
        "roman_ink": { "hex": "#912AD6", "name": "Roman candle (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#7777BC", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#8383C1", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" }
      },
      "colors": {
        "brand": {
          "line": "gold_ink"
        },
        "ui": {
          "background": "light_page",
          "foreground": "navy",
          "surface": "light_panel",
          "line_highlight": "light_current_line",
          "border": "light_border",
          "muted": "light_muted_text",
          "selection": "light_selection",
          "cursor": "navy",
          "accent": "gold_ink"
        },
        "status": {
          "success": "stars_ink",
          "warning": "gold_ink",
          "error": "firebrick",
          "info": "liberty_ink"
        },
        "syntax": {
          "comment": { "color": "light_muted_text", "style": "italic" },
          "keyword": "stripe_red_ink",
          "string": "picnic_ink",
          "number": "gold_ink",
          "constant": "gold_ink",
          "function": "fountain_ink",
          "type": "roman_ink",
          "variable": "navy",
          "parameter": "navy",
          "property": "navy",
          "operator": "navy",
          "punctuation": "navy",
          "tag": "stripe_red_ink",
          "attribute": "fountain_ink",
          "regex": "picnic_ink",
          "invalid": "stripe_red_ink"
        },
        "terminal": {
          "background": "light_page",
          "foreground": "navy",
          "cursor": "navy",
          "selection": "light_selection",
          "black": "navy",
          "bright_black": "light_muted_text",
          "white": "light_terminal_white",
          "bright_white": "light_terminal_bright_white",
          "red": "stripe_red_ink",
          "bright_red": "stripe_red_ink",
          "green": "picnic_ink",
          "bright_green": "picnic_ink",
          "yellow": "gold_ink",
          "bright_yellow": "gold_ink",
          "blue": "liberty_ink",
          "bright_blue": "liberty_ink",
          "magenta": "roman_ink",
          "bright_magenta": "roman_ink",
          "cyan": "fountain_ink",
          "bright_cyan": "fountain_ink"
        }
      },
      "targets": {
        "vscode": { "accent": "ui.accent" }
      }
    }
  }
}
