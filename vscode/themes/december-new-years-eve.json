  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#C0C0C0", "fontStyle": "italic" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#FFD700", "fontStyle": "" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#F5EFE4", "fontStyle": "" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#8FD8FF", "fontStyle": "" } },
    { "name": "Regular expressions", "scope": ["string.regexp"], "settings": { "foreground": "#8FD8FF", "fontStyle": "" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#FFD700", "fontStyle": "" } },
    { "name": "Constants", "scope": ["constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant"], "settings": { "foreground": "#FFD700", "fontStyle": "" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#1E90FF", "fontStyle": "" } },
    { "name": "Types", "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive"], "settings": { "foreground": "#FF6FAE", "fontStyle": "" } },
    { "name": "Variables", "scope": ["variable", "variable.other", "variable.other.readwrite"], "settings": { "foreground": "#F5EFE4", "fontStyle": "" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#F5EFE4", "fontStyle": "" } },
    { "name": "Properties", "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#F5EFE4", "fontStyle": "" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#F5EFE4", "fontStyle": "" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#FFD700", "fontStyle": "" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#1E90FF", "fontStyle": "" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF4500", "fontStyle": "" } },
    { "name": "Markup headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#FFD700", "fontStyle": "bold" } },
    { "name": "Markup bold", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "Markup italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markup code", "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#8FD8FF" } },
    { "name": "Markup links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#1E90FF" } },
    { "name": "Markup quotes", "scope": ["markup.quote"], "settings": { "foreground": "#C0C0C0", "fontStyle": "italic" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#5FBF6A" } },
    { "name": "Diff deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#FF4500" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#FFD700" } }
  ],
  "semanticTokenColors": {
    "namespace": "#FF6FAE",
    "class": "#FF6FAE",
    "interface": "#FF6FAE",
    "enum": "#FF6FAE",
    "struct": "#FF6FAE",
    "type": "#FF6FAE",
    "typeParameter": "#FF6FAE",
    "function": "#1E90FF",
    "method": "#1E90FF",
    "macro": "#1E90FF",
    "parameter": "#F5EFE4",
    "property": "#F5EFE4",
    "enumMember": "#FFD700",
    "variable": "#F5EFE4",
    "variable.readonly": "#FFD700",
    "keyword": "#FFD700",
    "string": "#8FD8FF",
    "number": "#FFD700",
    "regexp": "#8FD8FF",
    "comment": "#C0C0C0"
  }
}
