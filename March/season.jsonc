{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "March",
  "name": "St. Patrick's Day",
  "tagline": "Shamrocks, gold coins and a pint at the end of the rainbow",
  "description": [
    "March is St. Patrick's Day: dark, shamrock and lime greens with a pot of gold.",
    "Shamrocks, top hats, rainbows and a pint of beer, with the first hint of spring."
  ],
  "mood": ["lucky", "festive", "fresh", "cheerful"],
  "keywords": ["shamrocks", "pot of gold", "rainbow", "top hat", "green hills", "Irish pub", "four-leaf clover"],
  "holidays": [
    { "name": "St. Patrick's Day", "date": "03-17" },
    { "name": "Spring equinox", "date": "03-20", "note": "around the 20th" }
  ],
  "links": [
    { "title": "Emojipedia: St. Patrick's Day", "url": "https://emojipedia.org/st-patricks-day" }
  ],
  "ideas": [
    "The old theme shortened the path to the last 3 folders and cut branch names at 15 characters; the shared layout could offer both to every month",
    "🪙 gold coins or 🌈 rainbows in more segments"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "dark_green": { "hex": "#006400", "name": "Dark green" },
    "shamrock":   { "hex": "#009E60", "name": "Shamrock green" },
    "lime":       { "hex": "#32CD32", "name": "Lime green" },
    "gold":       { "hex": "#FFD700", "name": "Pot of gold" },
    "white":      { "hex": "#FFFFFF", "name": "White" },
    "black":      { "hex": "#000000", "name": "Black" },
    "orange_red": { "hex": "#FF4500", "name": "Orange red" },
    "pub":        { "hex": "#0E1F16", "name": "Pub snug", "note": "Proposed: editor and terminal background" },
    "moss":       { "hex": "#1B3325", "name": "Moss", "note": "Proposed: panels, borders, current line" },
    "linen":      { "hex": "#E8F3EA", "name": "Irish linen", "note": "Proposed: editor text" },
    "sage":       { "hex": "#8FAF98", "name": "Sage", "note": "Proposed: comments, muted text" },
    "ale":        { "hex": "#C08A3E", "name": "Amber ale", "note": "Proposed: keywords" },
    "ginger":     { "hex": "#E86A5C", "name": "Ginger red", "note": "Proposed: terminal red, invalid code" },
    "harp":       { "hex": "#6FA8DC", "name": "Harp blue", "note": "Proposed: terminal blue, info" },
    "heather":    { "hex": "#C58FD6", "name": "Heather", "note": "Proposed: terminal magenta, types" },
    "sea":        { "hex": "#5FD4C0", "name": "Atlantic teal", "note": "Proposed: terminal cyan" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "dark_green",
      "secondary":   "shamrock",
      "tertiary":    "lime",
      "accent":      "gold",
      "accent_alt":  "gold",
      "highlight":   "dark_green",
      "deep":        "shamrock",
      "text_accent": "white",
      "line":        "lime"
    },
    "ui": {
      "text_light":     "white",
      "text_dark":      "black",
      "background":     "pub",
      "foreground":     "linen",
      "surface":        "moss",
      "line_highlight": "moss",
      "border":         "moss",
      "muted":          "sage",
      "selection":      "dark_green",
      "cursor":         "gold"
    },
    "status": {
      "success": "white",
      "warning": "gold",
      "error":   "orange_red",
      "info":    "harp"
    },
    "syntax": {
      "comment":  { "color": "sage", "style": "italic" },
      "keyword":  "ale",
      "string":   "lime",
      "number":   "gold",
      "constant": "gold",
      "function": "shamrock",
      "type":     "heather",
      "variable": "linen",
      "invalid":  "ginger"
    },
    "terminal": {
      "black":         "moss",
      "red":           "ginger",
      "green":         "lime",
      "yellow":        "gold",
      "blue":          "harp",
      "magenta":       "heather",
      "cyan":          "sea",
      "white":         "linen",
      "bright_black":  "sage",
      "bright_red":    "orange_red",
      "bright_green":  "shamrock",
      "bright_white":  "white"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "☘️",
    "root":       "🎩",
    "path":       "🍻",
    "folder":     "🍻",
    "home":       "🤞",
    "git":        "☘️",
    "exec_time":  "⌛",
    "clock":      "🌈🪙",
    "battery":    "☘️",
    "status_ok":  "🍀🍺",
    "status_err": "😫",
    "language":   "☘️",
    "lang": {
      "yarn":    "🌈",
      "python":  "🎩",
      "java":    "🍺",
      "go":      "🌈",
      "rust":    "🎩",
      "dart":    "🍺",
      "nx":      "🌈",
      "julia":   "🎩",
      "ruby":    "🍺",
      "aws":     "🌈",
      "kubectl": "🎩"
    },
    "os": {
      "linux":   "☘️",
      "macos":   "🍏",
      "windows": "🎩"
    },
    "pool": ["🍀", "🌈", "🇮🇪", "🌱", "🤞", "🍺", "💚", "🟢", "🥬", "🍏", "🎩", "🥗", "📗", "🪙"]
  },

  // ── Per-program extras ──────────────────────────────────────────────────
  "targets": {
    "vscode": {
      "status_bar": "brand.secondary"
    },
    "oh-my-posh": {
      "time_format": "2006-01-02 3:04:05 PM"
    }
  },

  // ── Light mode ──────────────────────────────────────────────────────────
  "modes": {
    // Drafted by tools/New-LightMode.ps1 from the dark colours: tune freely.
    "light": {
      "palette": {
        "lime_ink": { "hex": "#1D781D", "name": "Lime green (light-mode ink)", "note": "Proposed: light mode" },
        "light_page": { "hex": "#EDF4ED", "name": "Light-mode page", "note": "Proposed: light mode" },
        "light_ink": { "hex": "#000F00", "name": "Light-mode ink", "note": "Proposed: light mode" },
        "light_panel": { "hex": "#DEEBDE", "name": "Light-mode panel", "note": "Proposed: light mode" },
        "light_current_line": { "hex": "#E3EEE3", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#B8D4B8", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#616B61", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#8CB98C", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "gold_ink": { "hex": "#7B6700", "name": "Pot of gold (light-mode ink)", "note": "Proposed: light mode" },
        "white_ink": { "hex": "#686868", "name": "White (light-mode ink)", "note": "Proposed: light mode" },
        "orange_red_ink": { "hex": "#C23400", "name": "Orange red (light-mode ink)", "note": "Proposed: light mode" },
        "harp_ink": { "hex": "#296BA8", "name": "Harp blue (light-mode ink)", "note": "Proposed: light mode" },
        "ale_ink": { "hex": "#87612C", "name": "Amber ale (light-mode ink)", "note": "Proposed: light mode" },
        "shamrock_ink": { "hex": "#007849", "name": "Shamrock green (light-mode ink)", "note": "Proposed: light mode" },
        "heather_ink": { "hex": "#9842B4", "name": "Heather (light-mode ink)", "note": "Proposed: light mode" },
        "ginger_ink": { "hex": "#C52D1C", "name": "Ginger red (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#7A837A", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#848F84", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" },
        "sea_ink": { "hex": "#1F7466", "name": "Atlantic teal (light-mode ink)", "note": "Proposed: light mode" }
      },
      "colors": {
        "brand": {
          "line": "lime_ink"
        },
        "ui": {
          "background": "light_page",
          "foreground": "light_ink",
          "surface": "light_panel",
          "line_highlight": "light_current_line",
          "border": "light_border",
          "muted": "light_muted_text",
          "selection": "light_selection",
          "cursor": "dark_green",
          "accent": "gold_ink"
        },
        "status": {
          "success": "white_ink",
          "warning": "gold_ink",
          "error": "orange_red_ink",
          "info": "harp_ink"
        },
        "syntax": {
          "comment": { "color": "light_muted_text", "style": "italic" },
          "keyword": "ale_ink",
          "string": "lime_ink",
          "number": "gold_ink",
          "constant": "gold_ink",
          "function": "shamrock_ink",
          "type": "heather_ink",
          "variable": "light_ink",
          "parameter": "light_ink",
          "property": "light_ink",
          "operator": "light_ink",
          "punctuation": "light_ink",
          "tag": "ale_ink",
          "attribute": "shamrock_ink",
          "regex": "lime_ink",
          "invalid": "ginger_ink"
        },
        "terminal": {
          "background": "light_page",
          "foreground": "light_ink",
          "cursor": "dark_green",
          "selection": "light_selection",
          "black": "light_ink",
          "bright_black": "light_muted_text",
          "white": "light_terminal_white",
          "bright_white": "light_terminal_bright_white",
          "red": "ginger_ink",
          "bright_red": "orange_red_ink",
          "green": "lime_ink",
          "bright_green": "shamrock_ink",
          "yellow": "gold_ink",
          "bright_yellow": "gold_ink",
          "blue": "harp_ink",
          "bright_blue": "harp_ink",
          "magenta": "heather_ink",
          "bright_magenta": "heather_ink",
          "cyan": "sea_ink",
          "bright_cyan": "sea_ink"
        }
      },
      "targets": {
        "vscode": { "accent": "ui.accent" }
      }
    }
  }
}
