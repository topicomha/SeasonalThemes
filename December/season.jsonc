        "light_current_line": { "hex": "#E3EEE3", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#B8D4B8", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#5F6B62", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#8CB98C", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "gold_ink": { "hex": "#7B6700", "name": "Star gold (light-mode ink)", "note": "Proposed: light mode" },
        "frost_ink": { "hex": "#007193", "name": "Frost (light-mode ink)", "note": "Proposed: light mode" },
        "icicle_ink": { "hex": "#246AB1", "name": "Icicle blue (light-mode ink)", "note": "Proposed: light mode" },
        "ornament_ink": { "hex": "#CA241E", "name": "Ornament red (light-mode ink)", "note": "Proposed: light mode" },
        "holly_ink": { "hex": "#2F7638", "name": "Holly green (light-mode ink)", "note": "Proposed: light mode" },
        "frost_teal_ink": { "hex": "#24736D", "name": "Frosted teal (light-mode ink)", "note": "Proposed: light mode" },
        "sugarplum_ink": { "hex": "#A13EAA", "name": "Sugarplum (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#79837C", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#848F86", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" }
      },
      "colors": {
