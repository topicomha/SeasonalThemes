  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#9BAA9C", "fontStyle": "italic" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#EC9288", "fontStyle": "" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#F4F1EA", "fontStyle": "" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#B3E88F", "fontStyle": "" } },
    { "name": "Regular expressions", "scope": ["string.regexp"], "settings": { "foreground": "#B3E88F", "fontStyle": "" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#FFE4A2", "fontStyle": "" } },
    { "name": "Constants", "scope": ["constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant"], "settings": { "foreground": "#FFE4A2", "fontStyle": "" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#7FD9C4", "fontStyle": "" } },
    { "name": "Types", "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive"], "settings": { "foreground": "#CDA0FF", "fontStyle": "" } },
    { "name": "Variables", "scope": ["variable", "variable.other", "variable.other.readwrite"], "settings": { "foreground": "#F4F1EA", "fontStyle": "" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#F4F1EA", "fontStyle": "" } },
    { "name": "Properties", "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#F4F1EA", "fontStyle": "" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#F4F1EA", "fontStyle": "" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#EC9288", "fontStyle": "" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#7FD9C4", "fontStyle": "" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#EC9288", "fontStyle": "" } },
    { "name": "Markup headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#EC9288", "fontStyle": "bold" } },
    { "name": "Markup bold", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "Markup italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markup code", "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#B3E88F" } },
    { "name": "Markup links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#9DB4FF" } },
    { "name": "Markup quotes", "scope": ["markup.quote"], "settings": { "foreground": "#9BAA9C", "fontStyle": "italic" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#B3E88F" } },
    { "name": "Diff deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#EC9288" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#FFE4A2" } }
  ],
  "semanticTokenColors": {
    "namespace": "#CDA0FF",
    "class": "#CDA0FF",
    "interface": "#CDA0FF",
    "enum": "#CDA0FF",
    "struct": "#CDA0FF",
    "type": "#CDA0FF",
    "typeParameter": "#CDA0FF",
    "function": "#7FD9C4",
    "method": "#7FD9C4",
    "macro": "#7FD9C4",
    "parameter": "#F4F1EA",
    "property": "#F4F1EA",
    "enumMember": "#FFE4A2",
    "variable": "#F4F1EA",
    "variable.readonly": "#FFE4A2",
    "keyword": "#EC9288",
    "string": "#B3E88F",
    "number": "#FFE4A2",
    "regexp": "#B3E88F",
    "comment": "#9BAA9C"
  }
}
