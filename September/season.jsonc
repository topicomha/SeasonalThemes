{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "September",
  "name": "Back to School",
  "tagline": "Apples, notebooks and the first falling leaves",
  "description": [
    "September is the turn from summer to fall: early autumn browns, sienna and goldenrod, paired with back-to-school icons.",
    "Apples, books and notebooks sit alongside the first fallen leaves; the dark text is chalkboard green."
  ],
  "mood": ["studious", "crisp", "warm", "nostalgic"],
  "keywords": ["red apple", "chalkboard", "stack of books", "school bus", "first fallen leaves", "goldenrod", "pencils"],
  "holidays": [
    { "name": "Labor Day", "date": "09-01", "note": "first Monday" },
    { "name": "Autumn equinox", "date": "09-22", "note": "around the 22nd" }
  ],
  "links": [
    { "title": "Emojipedia: Fall / Autumn", "url": "https://emojipedia.org/fall-autumn" },
    { "title": "Emojipedia: Graduation", "url": "https://emojipedia.org/graduation" }
  ],
  "ideas": [
    "More school supplies: ✏️ 📏 📐 for various segments",
    "🎒 backpack as an alternative home icon",
    "📝 memo or 📄 document icons for file-related segments",
    "The old theme coloured execution time yellow over 300 ms and red over 1 s; the shared layout could bring that back for every month"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "bark":        { "hex": "#8B4513", "name": "Bark brown" },
    "sienna":      { "hex": "#A0522D", "name": "Burnt sienna" },
    "goldenrod":   { "hex": "#DAA520", "name": "Goldenrod" },
    "peru":        { "hex": "#CD853F", "name": "Peru" },
    "harvest":     { "hex": "#B8860B", "name": "Harvest gold" },
    "chocolate":   { "hex": "#D2691E", "name": "Chocolate" },
    "apple":       { "hex": "#B22222", "name": "Apple red" },
    "green_apple": { "hex": "#8DB600", "name": "Green apple", "note": "Status success, to match the 🍏" },
    "paper":       { "hex": "#FFFFFF", "name": "Paper white" },
    "chalkboard":  { "hex": "#22302A", "name": "Chalkboard", "note": "Dark text on the light segments; also the editor background" },
    "board_edge":  { "hex": "#2E3F37", "name": "Board edge", "note": "Proposed: panels, borders, current line" },
    "chalk_dust":  { "hex": "#9AA89F", "name": "Chalk dust", "note": "Proposed: comments, muted text" },
    "chalk":       { "hex": "#F2EFE6", "name": "Chalk", "note": "Proposed: editor text" },
    "maple":       { "hex": "#E1782E", "name": "Maple orange", "note": "Proposed: chocolate lightened to read on chalkboard (keywords)" },
    "candy_apple": { "hex": "#E47474", "name": "Candy apple", "note": "Proposed: apple red lightened (terminal red, invalid code)" },
    "denim":       { "hex": "#6797D9", "name": "Denim blue", "note": "Proposed: terminal blue, info" },
    "plum":        { "hex": "#C77DBA", "name": "Plum", "note": "Proposed: terminal magenta" },
    "slate":       { "hex": "#5FC4B8", "name": "Slate teal", "note": "Proposed: terminal cyan, types" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "bark",
      "secondary":   "sienna",
      "tertiary":    "goldenrod",
      "accent":      "peru",
      "accent_alt":  "apple",
      "highlight":   "harvest",
      "deep":        "chocolate",
      "text_accent": "paper",
      "line":        "goldenrod"
    },
    "ui": {
      "text_light":     "paper",
      "text_dark":      "chalkboard",
      "background":     "chalkboard",
      "foreground":     "chalk",
      "surface":        "board_edge",
      "line_highlight": "board_edge",
      "border":         "board_edge",
      "muted":          "chalk_dust",
      "selection":      "sienna",
      "cursor":         "goldenrod"
    },
    "status": {
      "success": "green_apple",
      "warning": "goldenrod",
      "error":   "apple",
      "info":    "denim"
    },
    "syntax": {
      "comment":  { "color": "chalk_dust", "style": "italic" },
      "keyword":  "maple",
      "string":   "green_apple",
      "number":   "peru",
      "constant": "peru",
      "function": "goldenrod",
      "type":     "slate",
      "variable": "chalk",
      "invalid":  "candy_apple"
    },
    "terminal": {
      "black":         "board_edge",
      "red":           "candy_apple",
      "green":         "green_apple",
      "yellow":        "goldenrod",
      "blue":          "denim",
      "magenta":       "plum",
      "cyan":          "slate",
      "white":         "chalk",
      "bright_black":  "chalk_dust",
      "bright_red":    "maple",
      "bright_white":  "paper"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "🍎",
    "root":       "📚",
    "path":       "🍂",
    "folder":     "📓",
    "home":       "🏫",
    "git":        "🍁",
    "exec_time":  "🚌",
    "clock":      "🔔",
    "battery":    "🧃",
    "status_ok":  "🍏",
    "status_err": "🍎",
    "language":   "🍂",
    "lang": {
      "node":    "🍏",
      "npm":     "🥧",
      "yarn":    "🍁",
      "java":    "📚",
      "go":      "📚",
      "dart":    "📚",
      "nx":      "📚",
      "ruby":    "🍎",
      "kubectl": "📚"
    },
    "os": {
      "linux":   "🍂",
      "macos":   "🍏",
      "windows": "📐"
    },
    "pool": ["🎒", "🧑‍🏫", "✏️", "📏", "📐", "📝", "📄", "🎓", "📜", "🍊", "🌰", "☕", "🥧", "🌾"]
  },

  // ── Per-program extras ──────────────────────────────────────────────────
  "targets": {
    "vscode": {
      "status_bar": "brand.accent_alt"
    }
  },

  // ── Light mode ──────────────────────────────────────────────────────────
  "modes": {
    // Drafted by tools/New-LightMode.ps1 from the dark colours: tune freely.
    "light": {
      "palette": {
        "goldenrod_ink": { "hex": "#846413", "name": "Goldenrod (light-mode ink)", "note": "Proposed: light mode" },
        "light_page": { "hex": "#F7F2EE", "name": "Light-mode page", "note": "Proposed: light mode" },
        "light_ink": { "hex": "#323327", "name": "Light-mode ink", "note": "Proposed: light mode" },
        "light_panel": { "hex": "#F0E7E0", "name": "Light-mode panel", "note": "Proposed: light mode" },
        "light_current_line": { "hex": "#F2EBE5", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#DFCBBD", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#6B6962", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#D4B1A0", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "peru_ink": { "hex": "#945C27", "name": "Peru (light-mode ink)", "note": "Proposed: light mode" },
        "green_apple_ink": { "hex": "#587200", "name": "Green apple (light-mode ink)", "note": "Proposed: light mode" },
        "denim_ink": { "hex": "#2E68B9", "name": "Denim blue (light-mode ink)", "note": "Proposed: light mode" },
        "maple_ink": { "hex": "#A55218", "name": "Maple orange (light-mode ink)", "note": "Proposed: light mode" },
        "slate_ink": { "hex": "#2B746C", "name": "Slate teal (light-mode ink)", "note": "Proposed: light mode" },
        "candy_apple_ink": { "hex": "#C92727", "name": "Candy apple (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#84807A", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#908C85", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" },
        "plum_ink": { "hex": "#A24691", "name": "Plum (light-mode ink)", "note": "Proposed: light mode" }
      },
      "colors": {
        "brand": {
          "line": "goldenrod_ink"
        },
        "ui": {
          "background": "light_page",
          "foreground": "light_ink",
          "surface": "light_panel",
          "line_highlight": "light_current_line",
          "border": "light_border",
          "muted": "light_muted_text",
          "selection": "light_selection",
          "cursor": "bark",
          "accent": "peru_ink"
        },
        "status": {
          "success": "green_apple_ink",
          "warning": "goldenrod_ink",
          "error": "apple",
          "info": "denim_ink"
        },
        "syntax": {
          "comment": { "color": "light_muted_text", "style": "italic" },
          "keyword": "maple_ink",
          "string": "green_apple_ink",
          "number": "peru_ink",
          "constant": "peru_ink",
          "function": "goldenrod_ink",
          "type": "slate_ink",
          "variable": "light_ink",
          "parameter": "light_ink",
          "property": "light_ink",
          "operator": "light_ink",
          "punctuation": "light_ink",
          "tag": "maple_ink",
          "attribute": "goldenrod_ink",
          "regex": "green_apple_ink",
          "invalid": "candy_apple_ink"
        },
        "terminal": {
          "background": "light_page",
          "foreground": "light_ink",
          "cursor": "bark",
          "selection": "light_selection",
          "black": "light_ink",
          "bright_black": "light_muted_text",
          "white": "light_terminal_white",
          "bright_white": "light_terminal_bright_white",
          "red": "candy_apple_ink",
          "bright_red": "maple_ink",
          "green": "green_apple_ink",
          "bright_green": "green_apple_ink",
          "yellow": "goldenrod_ink",
          "bright_yellow": "goldenrod_ink",
          "blue": "denim_ink",
          "bright_blue": "denim_ink",
          "magenta": "plum_ink",
          "bright_magenta": "plum_ink",
          "cyan": "slate_ink",
          "bright_cyan": "slate_ink"
        }
      },
      "targets": {
        "vscode": { "accent": "ui.accent" }
      }
    }
  }
}
