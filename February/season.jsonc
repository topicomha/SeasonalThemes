{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "February",
  "name": "Valentine's Day",
  "tagline": "Roses, love letters and a box of chocolates",
  "description": [
    "February celebrates Valentine's Day with romantic burgundy, rose and deep pink, and hearts everywhere.",
    "Rose-pink text on white 'Valentine card' segments sits next to deep burgundy ones, like a box of chocolates and a love letter."
  ],
  "mood": ["romantic", "sweet", "warm", "playful"],
  "keywords": ["red roses", "love letter", "box of chocolates", "hearts", "teddy bear", "bouquet", "wax seal"],
  "holidays": [
    { "name": "Valentine's Day", "date": "02-14" }
  ],
  "links": [
    { "title": "Emojipedia: Valentine's Day", "url": "https://emojipedia.org/valentines-day" },
    { "title": "Emojipedia: Hearts", "url": "https://emojipedia.org/hearts" }
  ],
  "ideas": [
    "More heart variations: 💓 💗 💖 💕 for different segments",
    "Darker red backgrounds with white text for readability",
    "Light pink backgrounds with dark red text for contrast"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "burgundy":  { "hex": "#800020", "name": "Burgundy" },
    "rose":      { "hex": "#FF007F", "name": "Rose" },
    "deep_pink": { "hex": "#FF1493", "name": "Deep pink" },
    "hot_pink":  { "hex": "#FF69B4", "name": "Hot pink" },
    "blush":     { "hex": "#FFB6C1", "name": "Blush" },
    "card":      { "hex": "#FFFFFF", "name": "Valentine card white" },
    "wine":      { "hex": "#240A14", "name": "Red wine", "note": "Proposed: editor and terminal background" },
    "velvet":    { "hex": "#3A1422", "name": "Velvet", "note": "Proposed: panels, borders, current line" },
    "petal":     { "hex": "#F7E1E8", "name": "Rose petal", "note": "Proposed: editor text" },
    "mauve":     { "hex": "#B58A97", "name": "Dusty mauve", "note": "Proposed: comments, muted text" },
    "cherry":    { "hex": "#E05A6D", "name": "Cherry", "note": "Proposed: terminal red, invalid code" },
    "mint":      { "hex": "#7FC98B", "name": "Mint leaf", "note": "Proposed: terminal green" },
    "honey":     { "hex": "#F2C66D", "name": "Honey gold", "note": "Proposed: terminal yellow, numbers" },
    "cupid":     { "hex": "#7FA7E8", "name": "Cupid blue", "note": "Proposed: terminal blue, info" },
    "lilac":     { "hex": "#C990E8", "name": "Lilac", "note": "Proposed: terminal magenta, types" },
    "aqua":      { "hex": "#6FD1C9", "name": "Sea glass", "note": "Proposed: terminal cyan" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "burgundy",
      "secondary":   "rose",
      "tertiary":    "burgundy",
      "accent":      "rose",
      "accent_alt":  "card",
      "highlight":   "burgundy",
      "deep":        "deep_pink",
      "text_accent": "card",
      "line":        "hot_pink"
    },
    "ui": {
      "text_light":     "card",
      "text_dark":      "burgundy",
      "background":     "wine",
      "foreground":     "petal",
      "surface":        "velvet",
      "line_highlight": "velvet",
      "border":         "velvet",
      "muted":          "mauve",
      "selection":      "burgundy",
      "cursor":         "rose"
    },
    "status": {
      "success": "card",
      "warning": "honey",
      "error":   "deep_pink",
      "info":    "cupid"
    },
    "syntax": {
      "comment":  { "color": "mauve", "style": "italic" },
      "keyword":  "rose",
      "string":   "blush",
      "number":   "honey",
      "constant": "honey",
      "function": "hot_pink",
      "type":     "lilac",
      "variable": "petal",
      "invalid":  "cherry"
    },
    "terminal": {
      "black":         "velvet",
      "red":           "cherry",
      "green":         "mint",
      "yellow":        "honey",
      "blue":          "cupid",
      "magenta":       "lilac",
      "cyan":          "aqua",
      "white":         "petal",
      "bright_black":  "mauve",
      "bright_red":    "deep_pink",
      "bright_magenta": "hot_pink",
      "bright_white":  "card"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "🌹",
    "root":       "✨",
    "path":       "💗",
    "folder":     "💟",
    "home":       "💒",
    "git":        "💏",
    "exec_time":  "😘",
    "clock":      "💐🧸",
    "battery":    "💗",
    "status_ok":  "🫶",
    "status_err": "💔",
    "prompt":     "💌",
    "language":   "💕",
    "lang": {
      "npm":     "💐",
      "yarn":    "🧸",
      "node":    "🤍",
      "python":  "💗",
      "dotnet":  "💘",
      "go":      "🧸",
      "rust":    "💖",
      "dart":    "💗",
      "nx":      "💘",
      "julia":   "💝",
      "ruby":    "💖",
      "azfunc":  "💗",
      "kubectl": "💘"
    },
    "os": {
      "linux":   "💝",
      "macos":   "🍎",
      "windows": "💖"
    },
    "pool": ["❤️", "💞", "💓", "💮", "📮", "🎀", "🎁", "😍", "💋", "🌷", "💍", "🍫", "🥰", "💑", "🍓"]
  },

  // ── Per-program extras ──────────────────────────────────────────────────
  "targets": {
    "vscode": {
      "status_bar": "brand.secondary",
      "accent": "brand.line"
    },
    "oh-my-posh": {
      "time_format": "2006-01-02 3:04:05 PM"
    }
  }
}
