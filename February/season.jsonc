{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "February",
  "name": "Valentine's Day",
  "tagline": "Roses, love letters and a box of chocolates",
  "description": [
    "February celebrates Valentine's Day with romantic burgundy, rose and deep pink, and hearts everywhere.",
    "Rose-pink text on white 'Valentine card' segments sits next to deep burgundy ones, like a box of chocolates and a love letter."
  ],
  "mood": ["romantic", "sweet", "warm", "playful"],
  "keywords": ["red roses", "love letter", "box of chocolates", "hearts", "teddy bear", "bouquet", "wax seal"],
  "holidays": [
    { "name": "Valentine's Day", "date": "02-14" }
  ],
  "links": [
    { "title": "Emojipedia: Valentine's Day", "url": "https://emojipedia.org/valentines-day" },
    { "title": "Emojipedia: Hearts", "url": "https://emojipedia.org/hearts" }
  ],
  "ideas": [
    "More heart variations: 💓 💗 💖 💕 for different segments",
    "Darker red backgrounds with white text for readability",
    "Light pink backgrounds with dark red text for contrast"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "burgundy":  { "hex": "#800020", "name": "Burgundy" },
    "rose":      { "hex": "#FF007F", "name": "Rose" },
    "deep_pink": { "hex": "#FF1493", "name": "Deep pink" },
    "hot_pink":  { "hex": "#FF69B4", "name": "Hot pink" },
    "blush":     { "hex": "#FFB6C1", "name": "Blush" },
    "card":      { "hex": "#FFFFFF", "name": "Valentine card white" },
    "wine":      { "hex": "#240A14", "name": "Red wine", "note": "Proposed: editor and terminal background" },
    "velvet":    { "hex": "#3A1422", "name": "Velvet", "note": "Proposed: panels, borders, current line" },
    "petal":     { "hex": "#F7E1E8", "name": "Rose petal", "note": "Proposed: editor text" },
    "mauve":     { "hex": "#B58A97", "name": "Dusty mauve", "note": "Proposed: comments, muted text" },
    "cherry":    { "hex": "#E05A6D", "name": "Cherry", "note": "Proposed: terminal red, invalid code" },
    "mint":      { "hex": "#7FC98B", "name": "Mint leaf", "note": "Proposed: terminal green" },
    "honey":     { "hex": "#F2C66D", "name": "Honey gold", "note": "Proposed: terminal yellow, numbers" },
    "cupid":     { "hex": "#7FA7E8", "name": "Cupid blue", "note": "Proposed: terminal blue, info" },
    "lilac":     { "hex": "#C990E8", "name": "Lilac", "note": "Proposed: terminal magenta, types" },
    "aqua":      { "hex": "#6FD1C9", "name": "Sea glass", "note": "Proposed: terminal cyan" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "burgundy",
      "secondary":   "rose",
      "tertiary":    "burgundy",
      "accent":      "rose",
      "accent_alt":  "card",
      "highlight":   "burgundy",
      "deep":        "deep_pink",
      "text_accent": "card",
      "line":        "hot_pink"
    },
    "ui": {
      "text_light":     "card",
      "text_dark":      "burgundy",
      "background":     "wine",
      "foreground":     "petal",
      "surface":        "velvet",
      "line_highlight": "velvet",
      "border":         "velvet",
      "muted":          "mauve",
      "selection":      "burgundy",
      "cursor":         "rose"
    },
    "status": {
      "success": "card",
      "warning": "honey",
      "error":   "deep_pink",
      "info":    "cupid"
    },
    "syntax": {
      "comment":  { "color": "mauve", "style": "italic" },
      "keyword":  "rose",
      "string":   "blush",
      "number":   "honey",
      "constant": "honey",
      "function": "hot_pink",
      "type":     "lilac",
      "variable": "petal",
      "invalid":  "cherry"
    },
    "terminal": {
      "black":         "velvet",
      "red":           "cherry",
      "green":         "mint",
      "yellow":        "honey",
      "blue":          "cupid",
      "magenta":       "lilac",
      "cyan":          "aqua",
      "white":         "petal",
      "bright_black":  "mauve",
      "bright_red":    "deep_pink",
      "bright_magenta": "hot_pink",
      "bright_white":  "card"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "🌹",
    "root":       "✨",
    "path":       "💗",
    "folder":     "💟",
    "home":       "💒",
    "git":        "💏",
    "exec_time":  "😘",
    "clock":      "💐🧸",
    "battery":    "💗",
    "status_ok":  "🫶",
    "status_err": "💔",
    "prompt":     "💌",
    "language":   "💕",
    "lang": {
      "npm":     "💐",
      "yarn":    "🧸",
      "node":    "🤍",
      "python":  "💗",
      "dotnet":  "💘",
      "go":      "🧸",
      "rust":    "💖",
      "dart":    "💗",
      "nx":      "💘",
      "julia":   "💝",
      "ruby":    "💖",
      "azfunc":  "💗",
      "kubectl": "💘"
    },
    "os": {
      "linux":   "💝",
      "macos":   "🍎",
      "windows": "💖"
    },
    "pool": ["❤️", "💞", "💓", "💮", "📮", "🎀", "🎁", "😍", "💋", "🌷", "💍", "🍫", "🥰", "💑", "🍓"]
  },

  // ── Per-program extras ──────────────────────────────────────────────────
  "targets": {
    "vscode": {
      "status_bar": "brand.secondary",
      "accent": "brand.line"
    },
    "oh-my-posh": {
      "time_format": "2006-01-02 3:04:05 PM"
    }
  },

  // ── Light mode ──────────────────────────────────────────────────────────
  "modes": {
    // Drafted by tools/New-LightMode.ps1 from the dark colours: tune freely.
    "light": {
      "palette": {
        "hot_pink_ink": { "hex": "#C60063", "name": "Hot pink (light-mode ink)", "note": "Proposed: light mode" },
        "light_page": { "hex": "#F6EDEF", "name": "Light-mode page", "note": "Proposed: light mode" },
        "light_ink": { "hex": "#78001E", "name": "Light-mode ink", "note": "Proposed: light mode" },
        "light_panel": { "hex": "#EEDEE2", "name": "Light-mode panel", "note": "Proposed: light mode" },
        "light_current_line": { "hex": "#F1E3E6", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#DBB8C1", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#964F61", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#CD9AA7", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "card_ink": { "hex": "#646464", "name": "Valentine card white (light-mode ink)", "note": "Proposed: light mode" },
        "honey_ink": { "hex": "#865D0C", "name": "Honey gold (light-mode ink)", "note": "Proposed: light mode" },
        "deep_pink_ink": { "hex": "#C5006B", "name": "Deep pink (light-mode ink)", "note": "Proposed: light mode" },
        "cupid_ink": { "hex": "#2361C5", "name": "Cupid blue (light-mode ink)", "note": "Proposed: light mode" },
        "blush_ink": { "hex": "#CC001F", "name": "Blush (light-mode ink)", "note": "Proposed: light mode" },
        "lilac_ink": { "hex": "#972BD2", "name": "Lilac (light-mode ink)", "note": "Proposed: light mode" },
        "cherry_ink": { "hex": "#C1243B", "name": "Cherry (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#A96E7D", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#B17B89", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" },
        "mint_ink": { "hex": "#30723B", "name": "Mint leaf (light-mode ink)", "note": "Proposed: light mode" },
        "aqua_ink": { "hex": "#246F69", "name": "Sea glass (light-mode ink)", "note": "Proposed: light mode" }
      },
      "colors": {
        "brand": {
          "line": "hot_pink_ink"
        },
        "ui": {
          "background": "light_page",
          "foreground": "light_ink",
          "surface": "light_panel",
          "line_highlight": "light_current_line",
          "border": "light_border",
          "muted": "light_muted_text",
          "selection": "light_selection",
          "cursor": "burgundy",
          "accent": "hot_pink_ink"
        },
        "status": {
          "success": "card_ink",
          "warning": "honey_ink",
          "error": "deep_pink_ink",
          "info": "cupid_ink"
        },
        "syntax": {
          "comment": { "color": "light_muted_text", "style": "italic" },
          "keyword": "hot_pink_ink",
          "string": "blush_ink",
          "number": "honey_ink",
          "constant": "honey_ink",
          "function": "hot_pink_ink",
          "type": "lilac_ink",
          "variable": "light_ink",
          "parameter": "light_ink",
          "property": "light_ink",
          "operator": "light_ink",
          "punctuation": "light_ink",
          "tag": "hot_pink_ink",
          "attribute": "hot_pink_ink",
          "regex": "blush_ink",
          "invalid": "cherry_ink"
        },
        "terminal": {
          "background": "light_page",
          "foreground": "light_ink",
          "cursor": "burgundy",
          "selection": "light_selection",
          "black": "light_ink",
          "bright_black": "light_muted_text",
          "white": "light_terminal_white",
          "bright_white": "light_terminal_bright_white",
          "red": "cherry_ink",
          "bright_red": "deep_pink_ink",
          "green": "mint_ink",
          "bright_green": "mint_ink",
          "yellow": "honey_ink",
          "bright_yellow": "honey_ink",
          "blue": "cupid_ink",
          "bright_blue": "cupid_ink",
          "magenta": "lilac_ink",
          "bright_magenta": "hot_pink_ink",
          "cyan": "aqua_ink",
          "bright_cyan": "aqua_ink"
        }
      },
      "targets": {
        "vscode": { "accent": "ui.accent" }
      }
    }
  }
}
