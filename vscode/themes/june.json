  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#93A8BD", "fontStyle": "italic" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#FFBCD9", "fontStyle": "" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#F1F5F9", "fontStyle": "" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#98FB98", "fontStyle": "" } },
    { "name": "Regular expressions", "scope": ["string.regexp"], "settings": { "foreground": "#98FB98", "fontStyle": "" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#FFE08A", "fontStyle": "" } },
    { "name": "Constants", "scope": ["constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant"], "settings": { "foreground": "#FFE08A", "fontStyle": "" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#40E0D0", "fontStyle": "" } },
    { "name": "Types", "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive"], "settings": { "foreground": "#87CEEB", "fontStyle": "" } },
    { "name": "Variables", "scope": ["variable", "variable.other", "variable.other.readwrite"], "settings": { "foreground": "#F1F5F9", "fontStyle": "" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#F1F5F9", "fontStyle": "" } },
    { "name": "Properties", "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#F1F5F9", "fontStyle": "" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#F1F5F9", "fontStyle": "" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#FFBCD9", "fontStyle": "" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#40E0D0", "fontStyle": "" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF6F61", "fontStyle": "" } },
    { "name": "Markup headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#FFBCD9", "fontStyle": "bold" } },
    { "name": "Markup bold", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "Markup italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markup code", "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#98FB98" } },
    { "name": "Markup links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#87CEEB" } },
    { "name": "Markup quotes", "scope": ["markup.quote"], "settings": { "foreground": "#93A8BD", "fontStyle": "italic" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#98FB98" } },
    { "name": "Diff deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#FF6F61" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#FFE08A" } }
  ],
  "semanticTokenColors": {
    "namespace": "#87CEEB",
    "class": "#87CEEB",
    "interface": "#87CEEB",
    "enum": "#87CEEB",
    "struct": "#87CEEB",
    "type": "#87CEEB",
    "typeParameter": "#87CEEB",
    "function": "#40E0D0",
    "method": "#40E0D0",
    "macro": "#40E0D0",
    "parameter": "#F1F5F9",
    "property": "#F1F5F9",
    "enumMember": "#FFE08A",
    "variable": "#F1F5F9",
    "variable.readonly": "#FFE08A",
    "keyword": "#FFBCD9",
    "string": "#98FB98",
    "number": "#FFE08A",
    "regexp": "#98FB98",
    "comment": "#93A8BD"
  }
}
