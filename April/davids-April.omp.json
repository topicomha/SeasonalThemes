{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "╭─",
          "template": "🐰 {{ .Name }} ",
          "foreground": "#203C17",
          "background": "#B3E88F",
          "type": "shell",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<parentBackground>🌿</>  ",
          "foreground": "#202A5B",
          "background": "#B0FFFD",
          "type": "root",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_icon": " 🌻 ",
            "home_icon": " 🏡 ",
            "style": "folder"
          },
          "template": " 🌻 {{ .Path }} ",
          "foreground": "#203C17",
          "powerline_symbol": "",
          "background": "#EC9288",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "branch_icon": "🌞 ",
            "cache_duration": "none",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} ✏️ {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#B0FFFD> 📂 {{ .Staging.String }}</>{{ end }} ",
          "foreground": "#203C17",
          "powerline_symbol": "",
          "background": "#FFE4A2",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFE4A2{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FFE4A2{{ end }}",
            "{{ if gt .Ahead 0 }}#FFE4A2{{ end }}",
            "{{ if gt .Behind 0 }}#FFE4A2{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none",
            "style": "roundrock",
            "threshold": 0
          },
          "trailing_diamond": "",
          "template": " 🌈 {{ .FormattedMs }} ",
          "foreground": "#203C17",
          "background": "#B0FFFD",
          "type": "executiontime",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "fetch_package_manager": true,
            "npm_icon": " 🐝 ",
            "yarn_icon": " 🌈 "
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🐝 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "foreground": "#203C17",
          "background": "#CDA0FF",
          "type": "node",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🦋 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#B3E88F",
          "type": "python",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🐌 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#EC9288",
          "type": "java",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🐞 {{ if .Unsupported }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#B0FFFD",
          "type": "dotnet",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🐜 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#FFE4A2",
          "type": "go",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🦗 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#B3E88F",
          "type": "rust",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": " ",
          "trailing_diamond": " ",
          "template": "🕷️ {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#EC9288",
          "type": "dart",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": " ",
          "trailing_diamond": " ",
          "template": "🐢 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#FFE4A2",
          "type": "angular",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": " ",
          "trailing_diamond": " ",
          "template": "🐛 {{ if .Error }}{{ .Error }}{{ else }}Nx {{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#B0FFFD",
          "type": "nx",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": " ",
          "trailing_diamond": " ",
          "template": "🌸 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#CDA0FF",
          "type": "julia",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "🌼 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#FFE4A2",
          "type": "ruby",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "☂️ {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#203C17",
          "background": "#FFE4A2",
          "type": "azfunc",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": " ",
          "template": "⛅ {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
          "foreground": "#203C17",
          "background": "#B0FFFD",
          "type": "aws",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "🌧️ {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}",
          "foreground": "#203C17",
          "background": "#B3E88F",
          "type": "kubectl",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "linux": "🌅",
            "macos": "🌅",
            "windows": "🌅"
          },
          "leading_diamond": "",
          "trailing_diamond": "<transparent,background></>",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "#203C17",
          "background": "#CDA0FF",
          "type": "os",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "charged_icon": "🔋 ",
            "charging_icon": "⚡️ ",
            "discharging_icon": "📊 "
          },
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}🔋 ",
          "foreground": "#262626",
          "powerline_symbol": "",
          "background": "#FFE4A2",
          "type": "battery",
          "style": "powerline",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#b8e994{{end}}",
            "{{if eq \"Discharging\" .State.String}}#fff34e{{end}}",
            "{{if eq \"Full\" .State.String}}#33DD2D{{end}}"
          ],
          "invert_powerline": true
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "1/2 3:04 PM"
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " 🕰️ {{ .CurrentDate | date .Format }} ",
          "foreground": "#203C17",
          "background": "#FFE4A2",
          "type": "time",
          "style": "diamond",
          "invert_powerline": true
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "⌂──",
          "foreground": "#B3E88F",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "{{ if gt .Code 0 }}🥀{{ else }}🌱{{ end }}  ",
          "foreground": "#B3E88F",
          "type": "status",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#E8505B{{ end }}"
          ]
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
