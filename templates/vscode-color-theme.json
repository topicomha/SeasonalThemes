    "editorCursor.foreground": "[[color.ui.cursor]]",
    "editor.lineHighlightBackground": "[[color.ui.line_highlight]]",
    "editor.lineHighlightBorder": "[[color.ui.line_highlight]]",
    "editor.selectionBackground": "[[color.ui.selection]]99",
    "editor.inactiveSelectionBackground": "[[color.ui.selection]]55",
    "editor.selectionHighlightBackground": "[[color.brand.accent_alt]]33",
    "editor.wordHighlightBackground": "[[color.brand.tertiary]]33",
    "editor.wordHighlightStrongBackground": "[[choice.accent|ui.accent]]33",
    "editor.findMatchBackground": "[[choice.accent|ui.accent]]66",
    "editor.findMatchHighlightBackground": "[[choice.accent|ui.accent]]33",
    "editor.rangeHighlightBackground": "[[color.ui.line_highlight]]",
    "editorWhitespace.foreground": "[[color.ui.border]]",
    "editorIndentGuide.background1": "[[color.ui.border]]",
    "editorIndentGuide.activeBackground1": "[[color.ui.muted]]",
    "editorRuler.foreground": "[[color.ui.border]]",
    "editorCodeLens.foreground": "[[color.ui.muted]]",
    "editorLink.activeForeground": "[[color.terminal.blue]]",
    "editorBracketMatch.background": "[[choice.accent|ui.accent]]22",
    "editorBracketMatch.border": "[[choice.accent|ui.accent]]",
    "editorBracketHighlight.foreground1": "[[color.syntax.number]]",
    "editorBracketHighlight.foreground2": "[[color.syntax.type]]",
    "editorBracketHighlight.foreground3": "[[color.syntax.function]]",
    "editorBracketHighlight.foreground4": "[[color.syntax.keyword]]",
    "editorBracketHighlight.foreground5": "[[color.syntax.string]]",
    "editorBracketHighlight.foreground6": "[[color.terminal.cyan]]",
    "editorBracketHighlight.unexpectedBracket.foreground": "[[color.syntax.invalid]]",
    "editorError.foreground": "[[color.syntax.invalid]]",
    "editorWarning.foreground": "[[color.terminal.yellow]]",
    "editorInfo.foreground": "[[color.terminal.blue]]",
    "editorHint.foreground": "[[color.ui.muted]]",
    "editorGutter.background": "[[color.ui.background]]",
    "editorGutter.addedBackground": "[[color.terminal.green]]",
    "editorGutter.modifiedBackground": "[[color.terminal.yellow]]",
    "editorGutter.deletedBackground": "[[color.terminal.red]]",
    "editorOverviewRuler.border": "[[color.ui.border]]",
    "editorOverviewRuler.errorForeground": "[[color.syntax.invalid]]",
    "editorOverviewRuler.warningForeground": "[[color.terminal.yellow]]",
    "editorOverviewRuler.findMatchForeground": "[[choice.accent|ui.accent]]",
    "editorOverviewRuler.addedForeground": "[[color.terminal.green]]",
    "editorOverviewRuler.modifiedForeground": "[[color.terminal.yellow]]",
    "editorOverviewRuler.deletedForeground": "[[color.terminal.red]]",
    "diffEditor.insertedTextBackground": "[[color.terminal.green]]22",
    "diffEditor.removedTextBackground": "[[color.terminal.red]]22",
    "diffEditor.insertedLineBackground": "[[color.terminal.green]]14",
    "diffEditor.removedLineBackground": "[[color.terminal.red]]14",

    "editorWidget.background": "[[color.ui.surface]]",
    "editorWidget.foreground": "[[color.ui.foreground]]",
    "editorWidget.border": "[[color.ui.border]]",
    "editorSuggestWidget.background": "[[color.ui.surface]]",
    "editorSuggestWidget.foreground": "[[color.ui.foreground]]",
    "editorSuggestWidget.border": "[[color.ui.border]]",
    "editorSuggestWidget.highlightForeground": "[[choice.accent|ui.accent]]",
    "editorSuggestWidget.selectedBackground": "[[color.ui.selection]]",
    "editorSuggestWidget.selectedForeground": "[[on.ui.selection]]",
    "editorHoverWidget.background": "[[color.ui.surface]]",
    "editorHoverWidget.foreground": "[[color.ui.foreground]]",
    "editorHoverWidget.border": "[[color.ui.border]]",
    "peekView.border": "[[choice.accent|ui.accent]]",
    "peekViewEditor.background": "[[color.ui.surface]]",
    "peekViewResult.background": "[[color.ui.background]]",
    "peekViewTitle.background": "[[color.ui.surface]]",
    "peekViewEditor.matchHighlightBackground": "[[choice.accent|ui.accent]]44",
    "peekViewResult.matchHighlightBackground": "[[choice.accent|ui.accent]]44",

    "input.background": "[[color.ui.surface]]",
    "input.foreground": "[[color.ui.foreground]]",
    "input.border": "[[color.ui.border]]",
    "input.placeholderForeground": "[[color.ui.muted]]",
    "inputOption.activeBorder": "[[choice.accent|ui.accent]]",
    "inputOption.activeBackground": "[[choice.accent|ui.accent]]33",
    "inputValidation.errorBorder": "[[color.syntax.invalid]]",
    "inputValidation.warningBorder": "[[color.terminal.yellow]]",
    "inputValidation.infoBorder": "[[color.terminal.blue]]",
    "dropdown.background": "[[color.ui.surface]]",
    "dropdown.foreground": "[[color.ui.foreground]]",
    "dropdown.border": "[[color.ui.border]]",
    "checkbox.background": "[[color.ui.surface]]",
    "checkbox.foreground": "[[color.ui.foreground]]",
    "checkbox.border": "[[color.ui.border]]",

    "button.background": "[[choice.status_bar|brand.primary]]",
    "button.foreground": "[[on-choice.status_bar|brand.primary]]",
    "button.hoverBackground": "[[choice.status_bar|brand.primary]]CC",
    "button.secondaryBackground": "[[color.ui.line_highlight]]",
    "button.secondaryForeground": "[[color.ui.foreground]]",
    "badge.background": "[[choice.accent|ui.accent]]",
    "badge.foreground": "[[on-choice.accent|ui.accent]]",
    "progressBar.background": "[[choice.accent|ui.accent]]",
    "scrollbar.shadow": "#00000044",
    "scrollbarSlider.background": "[[color.ui.muted]]33",
    "scrollbarSlider.hoverBackground": "[[color.ui.muted]]55",
    "scrollbarSlider.activeBackground": "[[color.ui.muted]]77",

    "panel.background": "[[color.ui.background]]",
    "panel.border": "[[color.ui.border]]",
    "panelTitle.activeForeground": "[[color.ui.foreground]]",
    "panelTitle.inactiveForeground": "[[color.ui.muted]]",
    "panelTitle.activeBorder": "[[choice.accent|ui.accent]]",

    "statusBar.background": "[[choice.status_bar|brand.primary]]",
    "statusBar.foreground": "[[on-choice.status_bar|brand.primary]]",
    "statusBar.border": "[[choice.status_bar|brand.primary]]",
    "statusBar.debuggingBackground": "[[color.brand.highlight]]",
    "statusBar.debuggingForeground": "[[on.brand.highlight]]",
    "statusBar.noFolderBackground": "[[color.brand.secondary]]",
    "statusBar.noFolderForeground": "[[on.brand.secondary]]",
    "statusBarItem.remoteBackground": "[[choice.accent|ui.accent]]",
    "statusBarItem.remoteForeground": "[[on-choice.accent|ui.accent]]",
    "statusBarItem.hoverBackground": "#FFFFFF22",

    "notifications.background": "[[color.ui.surface]]",
    "notifications.foreground": "[[color.ui.foreground]]",
    "notifications.border": "[[color.ui.border]]",
    "notificationCenterHeader.background": "[[color.ui.surface]]",
    "notificationLink.foreground": "[[color.terminal.blue]]",
    "quickInput.background": "[[color.ui.surface]]",
    "quickInput.foreground": "[[color.ui.foreground]]",
    "quickInputList.focusBackground": "[[color.ui.selection]]",
    "quickInputList.focusForeground": "[[on.ui.selection]]",
    "pickerGroup.foreground": "[[choice.accent|ui.accent]]",
    "pickerGroup.border": "[[color.ui.border]]",
    "menu.background": "[[color.ui.surface]]",
    "menu.foreground": "[[color.ui.foreground]]",
    "menu.selectionBackground": "[[color.ui.selection]]",
    "menu.selectionForeground": "[[on.ui.selection]]",
    "menu.separatorBackground": "[[color.ui.border]]",

    "gitDecoration.addedResourceForeground": "[[color.terminal.green]]",
    "gitDecoration.untrackedResourceForeground": "[[color.terminal.green]]",
    "gitDecoration.modifiedResourceForeground": "[[color.terminal.yellow]]",
    "gitDecoration.deletedResourceForeground": "[[color.terminal.red]]",
    "gitDecoration.conflictingResourceForeground": "[[color.terminal.magenta]]",
    "gitDecoration.ignoredResourceForeground": "[[color.ui.muted]]",

    "terminal.background": "[[color.terminal.background]]",
    "terminal.foreground": "[[color.terminal.foreground]]",
    "terminalCursor.foreground": "[[color.terminal.cursor]]",
    "terminal.selectionBackground": "[[color.terminal.selection]]99",
    "terminal.ansiBlack": "[[color.terminal.black]]",
    "terminal.ansiRed": "[[color.terminal.red]]",
    "terminal.ansiGreen": "[[color.terminal.green]]",
    "terminal.ansiYellow": "[[color.terminal.yellow]]",
    "terminal.ansiBlue": "[[color.terminal.blue]]",
    "terminal.ansiMagenta": "[[color.terminal.magenta]]",
    "terminal.ansiCyan": "[[color.terminal.cyan]]",
    "terminal.ansiWhite": "[[color.terminal.white]]",
    "terminal.ansiBrightBlack": "[[color.terminal.bright_black]]",
    "terminal.ansiBrightRed": "[[color.terminal.bright_red]]",
    "terminal.ansiBrightGreen": "[[color.terminal.bright_green]]",
    "terminal.ansiBrightYellow": "[[color.terminal.bright_yellow]]",
    "terminal.ansiBrightBlue": "[[color.terminal.bright_blue]]",
    "terminal.ansiBrightMagenta": "[[color.terminal.bright_magenta]]",
    "terminal.ansiBrightCyan": "[[color.terminal.bright_cyan]]",
    "terminal.ansiBrightWhite": "[[color.terminal.bright_white]]"
  },
  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "[[color.syntax.comment]]", "fontStyle": "[[style.syntax.comment]]" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "[[color.syntax.keyword]]", "fontStyle": "[[style.syntax.keyword]]" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "[[color.syntax.operator]]", "fontStyle": "[[style.syntax.operator]]" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "[[color.syntax.string]]", "fontStyle": "[[style.syntax.string]]" } },
    { "name": "Regular expressions", "scope": ["string.regexp"], "settings": { "foreground": "[[color.syntax.regex]]", "fontStyle": "[[style.syntax.regex]]" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "[[color.syntax.number]]", "fontStyle": "[[style.syntax.number]]" } },
    { "name": "Constants", "scope": ["constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant"], "settings": { "foreground": "[[color.syntax.constant]]", "fontStyle": "[[style.syntax.constant]]" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "[[color.syntax.function]]", "fontStyle": "[[style.syntax.function]]" } },
    { "name": "Types", "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive"], "settings": { "foreground": "[[color.syntax.type]]", "fontStyle": "[[style.syntax.type]]" } },
    { "name": "Variables", "scope": ["variable", "variable.other", "variable.other.readwrite"], "settings": { "foreground": "[[color.syntax.variable]]", "fontStyle": "[[style.syntax.variable]]" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "[[color.syntax.parameter]]", "fontStyle": "[[style.syntax.parameter]]" } },
    { "name": "Properties", "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "[[color.syntax.property]]", "fontStyle": "[[style.syntax.property]]" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "[[color.syntax.punctuation]]", "fontStyle": "[[style.syntax.punctuation]]" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "[[color.syntax.tag]]", "fontStyle": "[[style.syntax.tag]]" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "[[color.syntax.attribute]]", "fontStyle": "[[style.syntax.attribute]]" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "[[color.syntax.invalid]]", "fontStyle": "[[style.syntax.invalid]]" } },
    { "name": "Markup headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "[[color.syntax.keyword]]", "fontStyle": "bold" } },
    { "name": "Markup bold", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "Markup italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markup code", "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "[[color.syntax.string]]" } },
    { "name": "Markup links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "[[color.terminal.blue]]" } },
    { "name": "Markup quotes", "scope": ["markup.quote"], "settings": { "foreground": "[[color.syntax.comment]]", "fontStyle": "italic" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "[[color.terminal.green]]" } },
    { "name": "Diff deleted", "scope": ["markup.deleted"], "settings": { "foreground": "[[color.terminal.red]]" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "[[color.terminal.yellow]]" } }
  ],
  "semanticTokenColors": {
    "namespace": "[[color.syntax.type]]",
    "class": "[[color.syntax.type]]",
    "interface": "[[color.syntax.type]]",
    "enum": "[[color.syntax.type]]",
    "struct": "[[color.syntax.type]]",
    "type": "[[color.syntax.type]]",
    "typeParameter": "[[color.syntax.type]]",
    "function": "[[color.syntax.function]]",
    "method": "[[color.syntax.function]]",
    "macro": "[[color.syntax.function]]",
    "parameter": "[[color.syntax.parameter]]",
    "property": "[[color.syntax.property]]",
    "enumMember": "[[color.syntax.constant]]",
    "variable": "[[color.syntax.variable]]",
    "variable.readonly": "[[color.syntax.constant]]",
    "keyword": "[[color.syntax.keyword]]",
    "string": "[[color.syntax.string]]",
    "number": "[[color.syntax.number]]",
    "regexp": "[[color.syntax.regex]]",
    "comment": "[[color.syntax.comment]]"
  }
}
