  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8FA9C2", "fontStyle": "italic" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#87CEEB", "fontStyle": "" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#E8F1F8", "fontStyle": "" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#6BC48A", "fontStyle": "" } },
    { "name": "Regular expressions", "scope": ["string.regexp"], "settings": { "foreground": "#6BC48A", "fontStyle": "" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#F2D06B", "fontStyle": "" } },
    { "name": "Constants", "scope": ["constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant"], "settings": { "foreground": "#F2D06B", "fontStyle": "" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#7FDBDA", "fontStyle": "" } },
    { "name": "Types", "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive"], "settings": { "foreground": "#C49BE0", "fontStyle": "" } },
    { "name": "Variables", "scope": ["variable", "variable.other", "variable.other.readwrite"], "settings": { "foreground": "#E8F1F8", "fontStyle": "" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#E8F1F8", "fontStyle": "" } },
    { "name": "Properties", "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#E8F1F8", "fontStyle": "" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#E8F1F8", "fontStyle": "" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#87CEEB", "fontStyle": "" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#7FDBDA", "fontStyle": "" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#E06C6C", "fontStyle": "" } },
    { "name": "Markup headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#87CEEB", "fontStyle": "bold" } },
    { "name": "Markup bold", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "Markup italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markup code", "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#6BC48A" } },
    { "name": "Markup links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#87CEEB" } },
    { "name": "Markup quotes", "scope": ["markup.quote"], "settings": { "foreground": "#8FA9C2", "fontStyle": "italic" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#6BC48A" } },
    { "name": "Diff deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#E06C6C" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#F2D06B" } }
  ],
  "semanticTokenColors": {
    "namespace": "#C49BE0",
    "class": "#C49BE0",
    "interface": "#C49BE0",
    "enum": "#C49BE0",
    "struct": "#C49BE0",
    "type": "#C49BE0",
    "typeParameter": "#C49BE0",
    "function": "#7FDBDA",
    "method": "#7FDBDA",
    "macro": "#7FDBDA",
    "parameter": "#E8F1F8",
    "property": "#E8F1F8",
    "enumMember": "#F2D06B",
    "variable": "#E8F1F8",
    "variable.readonly": "#F2D06B",
    "keyword": "#87CEEB",
    "string": "#6BC48A",
    "number": "#F2D06B",
    "regexp": "#6BC48A",
    "comment": "#8FA9C2"
  }
}
