  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8FA8A0", "fontStyle": "italic" } },
    { "name": "Keywords", "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#FF8C00", "fontStyle": "" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#FFFFFF", "fontStyle": "" } },
    { "name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#F0E68C", "fontStyle": "" } },
    { "name": "Regular expressions", "scope": ["string.regexp"], "settings": { "foreground": "#F0E68C", "fontStyle": "" } },
    { "name": "Numbers", "scope": ["constant.numeric"], "settings": { "foreground": "#40E0D0", "fontStyle": "" } },
    { "name": "Constants", "scope": ["constant.language", "constant.character", "constant.other", "support.constant", "variable.other.constant"], "settings": { "foreground": "#40E0D0", "fontStyle": "" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#FFD700", "fontStyle": "" } },
    { "name": "Types", "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive"], "settings": { "foreground": "#98FB98", "fontStyle": "" } },
    { "name": "Variables", "scope": ["variable", "variable.other", "variable.other.readwrite"], "settings": { "foreground": "#FFFFFF", "fontStyle": "" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#FFFFFF", "fontStyle": "" } },
    { "name": "Properties", "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"], "settings": { "foreground": "#FFFFFF", "fontStyle": "" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#FFFFFF", "fontStyle": "" } },
    { "name": "Tags", "scope": ["entity.name.tag"], "settings": { "foreground": "#FF8C00", "fontStyle": "" } },
    { "name": "Attributes", "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#FFD700", "fontStyle": "" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF6B5B", "fontStyle": "" } },
    { "name": "Markup headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#FF8C00", "fontStyle": "bold" } },
    { "name": "Markup bold", "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "name": "Markup italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markup code", "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#F0E68C" } },
    { "name": "Markup links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#4AA3DF" } },
    { "name": "Markup quotes", "scope": ["markup.quote"], "settings": { "foreground": "#8FA8A0", "fontStyle": "italic" } },
    { "name": "Diff inserted", "scope": ["markup.inserted"], "settings": { "foreground": "#98FB98" } },
    { "name": "Diff deleted", "scope": ["markup.deleted"], "settings": { "foreground": "#FF6B5B" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#FFD700" } }
  ],
  "semanticTokenColors": {
    "namespace": "#98FB98",
    "class": "#98FB98",
    "interface": "#98FB98",
    "enum": "#98FB98",
    "struct": "#98FB98",
    "type": "#98FB98",
    "typeParameter": "#98FB98",
    "function": "#FFD700",
    "method": "#FFD700",
    "macro": "#FFD700",
    "parameter": "#FFFFFF",
    "property": "#FFFFFF",
    "enumMember": "#40E0D0",
    "variable": "#FFFFFF",
    "variable.readonly": "#40E0D0",
    "keyword": "#FF8C00",
    "string": "#F0E68C",
    "number": "#40E0D0",
    "regexp": "#F0E68C",
    "comment": "#8FA8A0"
  }
}
