{
  "$schema": "../schema/season.schema.json",

  // ── Identity ────────────────────────────────────────────────────────────
  "month": "April",
  "name": "Spring Showers",
  "tagline": "Pastel blooms, bunnies and bugs after the rain",
  "description": [
    "April is spring in full pastel: light green, sky cyan, salmon, butter yellow and lavender.",
    "The icons are the garden waking up (seedlings, sunflowers, bees, butterflies and ladybugs), with an Easter bunny and a rainbow after the April showers."
  ],
  "mood": ["fresh", "gentle", "playful", "blooming"],
  "keywords": ["spring garden", "Easter eggs", "bunny", "tulips", "rain showers", "rainbow", "butterflies", "bees"],
  "holidays": [
    { "name": "April Fools' Day", "date": "04-01" },
    { "name": "Easter", "date": "04-05", "note": "a Sunday between March 22 and April 25" },
    { "name": "Earth Day", "date": "04-22" }
  ],
  "links": [
    { "title": "Emojipedia: Easter", "url": "https://emojipedia.org/easter" },
    { "title": "Emojipedia: Spring", "url": "https://emojipedia.org/spring" }
  ],
  "ideas": [
    "The old theme gave every pastel its own matching dark text (forest, navy, mahogany, golden brown, plum); the layout could support a text colour per role",
    "A light editor theme would suit April's pastels",
    "The battery segment used April's own pastels for charging / discharging / full"
  ],
  "appearance": "dark",

  // ── Palette ─────────────────────────────────────────────────────────────
  "palette": {
    "spring_green": { "hex": "#B3E88F", "name": "Spring green" },
    "rain_cyan":    { "hex": "#B0FFFD", "name": "Rain cyan" },
    "salmon":       { "hex": "#EC9288", "name": "Salmon" },
    "butter":       { "hex": "#FFE4A2", "name": "Butter yellow" },
    "lavender":     { "hex": "#CDA0FF", "name": "Lavender" },
    "forest":       { "hex": "#203C17", "name": "Deep forest green" },
    "navy":         { "hex": "#202A5B", "name": "Navy" },
    "white":        { "hex": "#FFFFFF", "name": "White" },
    "tulip":        { "hex": "#E8505B", "name": "Tulip red", "note": "New: the old theme had no error colour" },
    "night_garden": { "hex": "#1B2420", "name": "Night garden", "note": "Proposed: editor and terminal background" },
    "hedge":        { "hex": "#27332D", "name": "Hedge", "note": "Proposed: panels, borders, current line" },
    "eggshell":     { "hex": "#F4F1EA", "name": "Eggshell", "note": "Proposed: editor text" },
    "lichen":       { "hex": "#9BAA9C", "name": "Lichen", "note": "Proposed: comments, muted text" },
    "periwinkle":   { "hex": "#9DB4FF", "name": "Periwinkle", "note": "Proposed: terminal blue, info" },
    "mint":         { "hex": "#7FD9C4", "name": "Mint", "note": "Proposed: functions" }
  },

  // ── Colour roles ────────────────────────────────────────────────────────
  "colors": {
    "brand": {
      "primary":     "spring_green",
      "secondary":   "rain_cyan",
      "tertiary":    "salmon",
      "accent":      "butter",
      "accent_alt":  "butter",
      "highlight":   "lavender",
      "deep":        "rain_cyan",
      "text_accent": "navy",
      "line":        "spring_green"
    },
    "ui": {
      "text_light":     "white",
      "text_dark":      "forest",
      "background":     "night_garden",
      "foreground":     "eggshell",
      "surface":        "hedge",
      "line_highlight": "hedge",
      "border":         "hedge",
      "muted":          "lichen",
      "selection":      "forest",
      "cursor":         "butter"
    },
    "status": {
      "success": "spring_green",
      "warning": "butter",
      "error":   "tulip",
      "info":    "periwinkle"
    },
    "syntax": {
      "comment":  { "color": "lichen", "style": "italic" },
      "keyword":  "salmon",
      "string":   "spring_green",
      "number":   "butter",
      "constant": "butter",
      "function": "mint",
      "type":     "lavender",
      "variable": "eggshell",
      "invalid":  "salmon"
    },
    "terminal": {
      "black":         "hedge",
      "red":           "salmon",
      "green":         "spring_green",
      "yellow":        "butter",
      "blue":          "periwinkle",
      "magenta":       "lavender",
      "cyan":          "rain_cyan",
      "white":         "eggshell",
      "bright_black":  "lichen",
      "bright_green":  "mint",
      "bright_white":  "white"
    }
  },

  // ── Icons ───────────────────────────────────────────────────────────────
  "icons": {
    "shell":      "🐰",
    "root":       "🌿",
    "path":       "🌻",
    "folder":     "🌻",
    "home":       "🏡",
    "git":        "🌞",
    "exec_time":  "🌈",
    "clock":      "🕰️",
    "battery":    "📊",
    "status_ok":  "🌱",
    "status_err": "🥀",
    "language":   "🌱",
    "lang": {
      "node":    "🐝",
      "npm":     "🐝",
      "yarn":    "🌈",
      "python":  "🦋",
      "java":    "🐌",
      "dotnet":  "🐞",
      "go":      "🐜",
      "rust":    "🦗",
      "dart":    "🕷️",
      "angular": "🐢",
      "nx":      "🐛",
      "julia":   "🌸",
      "ruby":    "🌼",
      "azfunc":  "☂️",
      "aws":     "⛅",
      "kubectl": "🌧️"
    },
    "os": {
      "linux":   "🌅",
      "macos":   "🌅",
      "windows": "🌅"
    },
    "pool": ["🌼", "☔", "🐣", "🥚", "🐇", "🌷", "🌳", "🍀", "🍃", "🦔", "🦢", "🐑", "🧺", "🐤", "🥕"]
  },

  // ── Per-program extras ──────────────────────────────────────────────────
  "targets": {
    "oh-my-posh": {
      "time_format": "1/2 3:04 PM"
    }
  },

  // ── Light mode ──────────────────────────────────────────────────────────
  "modes": {
    // Drafted by tools/New-LightMode.ps1 from the dark colours: tune freely.
    "light": {
      "palette": {
        "spring_green_ink": { "hex": "#44821B", "name": "Spring green (light-mode ink)", "note": "Proposed: light mode" },
        "light_page": { "hex": "#FAFDF7", "name": "Light-mode page", "note": "Proposed: light mode" },
        "light_ink": { "hex": "#2D4722", "name": "Light-mode ink", "note": "Proposed: light mode" },
        "light_panel": { "hex": "#F5FCF0", "name": "Light-mode panel", "note": "Proposed: light mode" },
        "light_current_line": { "hex": "#F7FCF3", "name": "Light-mode current line", "note": "Proposed: light mode" },
        "light_border": { "hex": "#EAF9E0", "name": "Light-mode border", "note": "Proposed: light mode" },
        "light_muted_text": { "hex": "#697761", "name": "Light-mode muted text", "note": "Proposed: light mode" },
        "light_selection": { "hex": "#9BA797", "name": "Light-mode selection", "note": "Proposed: light mode" },
        "butter_ink": { "hex": "#976B00", "name": "Butter yellow (light-mode ink)", "note": "Proposed: light mode" },
        "tulip_ink": { "hex": "#E11F2D", "name": "Tulip red (light-mode ink)", "note": "Proposed: light mode" },
        "periwinkle_ink": { "hex": "#3565FF", "name": "Periwinkle (light-mode ink)", "note": "Proposed: light mode" },
        "salmon_ink": { "hex": "#D83523", "name": "Salmon (light-mode ink)", "note": "Proposed: light mode" },
        "mint_ink": { "hex": "#26816C", "name": "Mint (light-mode ink)", "note": "Proposed: light mode" },
        "lavender_ink": { "hex": "#993CFF", "name": "Lavender (light-mode ink)", "note": "Proposed: light mode" },
        "light_terminal_white": { "hex": "#7E8B76", "name": "Light-mode terminal white", "note": "Proposed: light mode" },
        "light_terminal_bright_white": { "hex": "#8A9682", "name": "Light-mode terminal bright white", "note": "Proposed: light mode" },
        "rain_cyan_ink": { "hex": "#00817E", "name": "Rain cyan (light-mode ink)", "note": "Proposed: light mode" }
      },
      "colors": {
        "brand": {
          "line": "spring_green_ink"
        },
        "ui": {
          "background": "light_page",
          "foreground": "light_ink",
          "surface": "light_panel",
          "line_highlight": "light_current_line",
          "border": "light_border",
          "muted": "light_muted_text",
          "selection": "light_selection",
          "cursor": "spring_green_ink",
          "accent": "butter_ink"
        },
        "status": {
          "success": "spring_green_ink",
          "warning": "butter_ink",
          "error": "tulip_ink",
          "info": "periwinkle_ink"
        },
        "syntax": {
          "comment": { "color": "light_muted_text", "style": "italic" },
          "keyword": "salmon_ink",
          "string": "spring_green_ink",
          "number": "butter_ink",
          "constant": "butter_ink",
          "function": "mint_ink",
          "type": "lavender_ink",
          "variable": "light_ink",
          "parameter": "light_ink",
          "property": "light_ink",
          "operator": "light_ink",
          "punctuation": "light_ink",
          "tag": "salmon_ink",
          "attribute": "mint_ink",
          "regex": "spring_green_ink",
          "invalid": "salmon_ink"
        },
        "terminal": {
          "background": "light_page",
          "foreground": "light_ink",
          "cursor": "spring_green_ink",
          "selection": "light_selection",
          "black": "light_ink",
          "bright_black": "light_muted_text",
          "white": "light_terminal_white",
          "bright_white": "light_terminal_bright_white",
          "red": "salmon_ink",
          "bright_red": "salmon_ink",
          "green": "spring_green_ink",
          "bright_green": "mint_ink",
          "yellow": "butter_ink",
          "bright_yellow": "butter_ink",
          "blue": "periwinkle_ink",
          "bright_blue": "periwinkle_ink",
          "magenta": "lavender_ink",
          "bright_magenta": "lavender_ink",
          "cyan": "rain_cyan_ink",
          "bright_cyan": "rain_cyan_ink"
        }
      },
      "targets": {
        "vscode": { "accent": "ui.accent" }
      }
    }
  }
}
